{
  "name": "aurum-edge-terminal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "dev:backend": "uvicorn app.main:app --app-dir backend --reload --host 0.0.0.0 --port 8000",
    "dev:all": "concurrently \"uvicorn app.main:app --app-dir backend --reload --host 0.0.0.0 --port 8000\" \"vite --host 0.0.0.0 --port 5173\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint ."
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lightweight-charts": "4.2.2",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2"
  }
}
