# ─── Trading backend ────────────────────────────────────────────────────────
# Copy to .env and fill in your own keys. Nothing here generates data: without a real
# provider key the API answers with an explicit error and the UI shows an offline state.
AURUM_ENVIRONMENT=development
AURUM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required for prices/candles: free key from https://twelvedata.com/pricing
AURUM_TWELVE_DATA_API_KEY=
AURUM_MARKET_SYMBOL=XAU/USD

# Optional English news. Economic calendar integration is NOT implemented yet.
AURUM_FMP_API_KEY=

# Optional Persian RSS/Atom feed with your own license. Both URL and exact HTTPS host
# are required; no default publisher is scraped and missing news fails closed.
AURUM_FA_NEWS_RSS_URL=
AURUM_FA_NEWS_ALLOWED_HOST=
AURUM_FA_NEWS_SOURCE=منبع خبری دارای مجوز
AURUM_NEWS_HOLD_MINUTES=45

# Optional: LLM-based manual news analysis (falls back to rules)
AURUM_OPENAI_API_KEY=
AURUM_OPENAI_MODEL=gpt-4o-mini

# Optional cache dir for real candle snapshots
# AURUM_CACHE_DIR=app/data/cache
