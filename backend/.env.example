# ─── Trading backend ────────────────────────────────────────────────────────
# Copy to .env and fill in your own keys. Nothing here generates data: without a real
# provider key the API answers with an explicit error and the UI shows an offline state.
AURUM_ENVIRONMENT=development

# Required for prices/candles: free key from https://twelvedata.com/pricing
AURUM_TWELVE_DATA_API_KEY=
AURUM_MARKET_SYMBOL=XAU/USD

# Optional legacy FMP headlines; /news/web already checks the public Forex Factory
# weekly calendar independently. A calendar event is NOT a released result.
AURUM_FMP_API_KEY=

# Built-in /api/v1/news/web reads ONLY publisher-advertised public RSS headlines and
# short excerpts: IRIB News, YJC, Eghtesaad24, CoinDesk, and BLS CPI/Employment.
# Review each publisher's rights before commercial redistribution. If ANY feed fails,
# the optional paper-entry news gate is UNKNOWN (blocked when enabled).
AURUM_NEWS_HOLD_MINUTES=45

# Optional legacy /api/v1/news/fa: a separate licensed feed of your own.
AURUM_FA_NEWS_RSS_URL=
AURUM_FA_NEWS_ALLOWED_HOST=
AURUM_FA_NEWS_SOURCE=منبع خبری دارای مجوز

# Read-only CoinGecko Demo key (free at coingecko.com). Keep on the server, not the APK;
# keyless API access can be throttled. Binance Spot market data needs no trade credentials.
AURUM_COINGECKO_DEMO_API_KEY=

# Optional server-only AI for XAU/USD. Choose Gemini 2.5 Flash-Lite's limited free
# tier (get YOUR OWN key from https://aistudio.google.com/apikey); no shared key in APK.
# Free-tier inputs may be used to improve the model. REVIEW each publisher's rights
# and explicitly consent before sending headline/excerpt text to a third party.
# Without BOTH a key and consent, or on ANY API/validation failure, AI stays UNKNOWN.
AURUM_GEMINI_API_KEY=
AURUM_GEMINI_MODEL=gemini-2.5-flash-lite
AURUM_AI_NEWS_EXTERNAL_CONSENT=false

# Legacy optional paid provider, only used when Gemini key is blank. No fallback to
# OpenAI when a configured Gemini call fails; this is deliberate fail-closed behavior.
AURUM_OPENAI_API_KEY=
AURUM_OPENAI_MODEL=gpt-4o-mini
# Optional: point the OFFICIAL OpenAI SDK at a different OpenAI-compatible host (self-hosted
# proxy or a third-party relay/gateway) instead of api.openai.com. Leave blank to use OpenAI
# directly. Setting this means headline/excerpt text is sent to THAT host, not OpenAI — review
# its own privacy/ToS the same way you would review OpenAI's or Gemini's before enabling consent.
AURUM_OPENAI_BASE_URL=

# Optional cache dir for real candle snapshots
# AURUM_CACHE_DIR=app/data/cache

# After starting the backend, inspect /api/v1/config/status to confirm every configured
# key has a destination. Add ?live_probe=true only when needed: it performs bounded live
# checks and may consume provider quota. It reports only configured=true/false, redacted
# endpoints, and safe error categories; it never returns secret values. Leading/trailing
# whitespace is removed automatically.
