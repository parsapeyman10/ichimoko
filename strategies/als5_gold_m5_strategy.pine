// This Pine Script™ v6 strategy is subject to the terms of the Mozilla Public License 2.0
// © ALS-5 Quantitative Architecture — XAUUSD M5 Adaptive Liquidity & Structure System
//@version=6
strategy(
     title               = "ALS-5 — Adaptive Liquidity & Structure Gold System",
     shorttitle          = "ALS-5 Gold M5",
     overlay             = true,
     initial_capital     = 10000,
     default_qty_type    = strategy.fixed,
     default_qty_value   = 1,
     currency            = currency.USD,
     // Per-qty-unit default: $0.08/oz half-spread + $0.035/oz broker commission per side.
     // If quantity units differ from ounces, adjust this strategy property in TradingView.
     commission_type     = strategy.commission.cash_per_contract,
     commission_value    = 0.115,
     slippage            = 2,
     calc_on_every_tick  = false,
     process_orders_on_close = true,
     max_bars_back       = 1500,
     max_lines_count     = 500,
     max_labels_count    = 500)

// ============================================================================
// 1. CONFIGURABLE PARAMETERS
// ============================================================================
grpRegime = "1. Regime & Structure (M15 + M5)"
regimeTf          = input.timeframe("15", "Higher-Timeframe Regime TF", group = grpRegime)
pivotLeft         = input.int(3, "Confirmed Swing Left Bars", minval = 2, maxval = 15, group = grpRegime)
pivotRight        = input.int(3, "Confirmed Swing Right Bars (No-Repaint Delay)", minval = 2, maxval = 15, group = grpRegime)
microPivotLeft    = input.int(2, "M5 Microstructure Pivot Left Bars", minval = 1, maxval = 10, group = grpRegime)
microPivotRight   = input.int(1, "M5 Microstructure Pivot Right Bars", minval = 1, maxval = 10, group = grpRegime)
atrLen            = input.int(14, "ATR Period", minval = 5, maxval = 50, group = grpRegime)
adxLen            = input.int(14, "ADX Period", minval = 5, maxval = 50, group = grpRegime)
emaLen            = input.int(50, "Structure Baseline EMA Period", minval = 10, maxval = 200, group = grpRegime)
trendAdxMin       = input.float(18.0, "Min ADX for Trend Regime", minval = 10.0, maxval = 40.0, step = 0.5, group = grpRegime)
rangeAdxMax       = input.float(20.0, "Max ADX for Range Regime", minval = 10.0, maxval = 35.0, step = 0.5, group = grpRegime)
highVolAtrMult    = input.float(2.2, "High-Volatility Lock (ATR / Median ATR)", minval = 1.3, maxval = 4.0, step = 0.1, group = grpRegime)
lowVolAtrMult     = input.float(0.55, "Dead-Market Lock (ATR / Median ATR)", minval = 0.2, maxval = 0.9, step = 0.05, group = grpRegime)

grpEngines = "2. Three Independent Trading Engines"
enableEngineA     = input.bool(true, "Enable Engine A — Trend Continuation", group = grpEngines)
enableEngineB     = input.bool(true, "Enable Engine B — Liquidity Sweep & Reversal", group = grpEngines)
enableEngineC     = input.bool(true, "Enable Engine C — Range Mean-Reversion", group = grpEngines)
minImpulseAtr     = input.float(1.1, "Engine A: Min Impulse Leg (x ATR)", minval = 0.5, maxval = 4.0, step = 0.1, group = grpEngines)
minPullbackFib    = input.float(0.28, "Engine A: Min Pullback Retracement", minval = 0.15, maxval = 0.60, step = 0.02, group = grpEngines)
maxPullbackFib    = input.float(0.85, "Engine A: Max Pullback Retracement", minval = 0.50, maxval = 0.95, step = 0.02, group = grpEngines)
maxChaseAtr       = input.float(1.25, "Engine A: Max Entry Distance from Confirmation (x ATR)", minval = 0.3, maxval = 3.0, step = 0.05, group = grpEngines)
pullbackZoneAtrTol = input.float(0.60, "Engine A: Structure-Retest Zone Tolerance (x ATR)", minval = 0.1, maxval = 2.0, step = 0.05, group = grpEngines)
minSwingProgressAtr = input.float(0.05, "Engine A: Min HH/HL Progress (x ATR)", minval = 0.0, maxval = 0.5, step = 0.01, group = grpEngines)
minRejectionWick   = input.float(0.40, "Min Rejection-Wick / Range Ratio", minval = 0.2, maxval = 0.85, step = 0.05, group = grpEngines)
minSweepAtr       = input.float(0.12, "Engine B: Min Sweep Excursion (x ATR)", minval = 0.05, maxval = 1.0, step = 0.02, group = grpEngines)
maxSweepAtr       = input.float(1.35, "Engine B: Max Sweep Excursion (x ATR)", minval = 0.5, maxval = 3.0, step = 0.05, group = grpEngines)
mssWindowBars     = input.int(6, "Engine B: Max Bars for MSS After Sweep", minval = 2, maxval = 15, group = grpEngines)
requireRetestB    = input.bool(false, "Engine B: Require Micro-Level Retest Before Entry", group = grpEngines)
retestToleranceAtr = input.float(0.25, "Engine B: Retest Tolerance (x ATR)", minval = 0.05, maxval = 1.0, step = 0.05, group = grpEngines)
minDispRatio      = input.float(0.45, "Min Displacement Body / Range Ratio", minval = 0.25, maxval = 0.85, step = 0.05, group = grpEngines)
minRangeWidthAtr  = input.float(1.8, "Engine C: Min Range Width (x ATR)", minval = 1.0, maxval = 4.0, step = 0.1, group = grpEngines)
maxRangeWidthAtr  = input.float(6.0, "Engine C: Max Range Width (x ATR)", minval = 3.0, maxval = 12.0, step = 0.5, group = grpEngines)
rangeZoneFrac     = input.float(0.22, "Engine C: Outer Boundary Entry Zone (0..0.30)", minval = 0.10, maxval = 0.30, step = 0.02, group = grpEngines)
rangeMidLowFrac   = input.float(0.25, "Engine C: Middle-Zone Lower Bound", minval = 0.10, maxval = 0.45, step = 0.01, group = grpEngines)
rangeMidHighFrac  = input.float(0.75, "Engine C: Middle-Zone Upper Bound", minval = 0.55, maxval = 0.90, step = 0.01, group = grpEngines)
rangeBreakoutAtr  = input.float(0.40, "Engine C: Range-Breakout Invalidation (x ATR)", minval = 0.05, maxval = 2.0, step = 0.05, group = grpEngines)
rangeEntryWickAtr = input.float(0.15, "Engine C: Boundary-Wick Entry Distance (x ATR)", minval = 0.0, maxval = 1.0, step = 0.05, group = grpEngines)
rangeTargetAtr    = input.float(0.15, "Engine C: Target Buffer from Opposing Boundary (x ATR)", minval = 0.0, maxval = 1.0, step = 0.05, group = grpEngines)
maxSpreadAtrRatio = input.float(0.25, "Hard Max Spread / M5 ATR Ratio", minval = 0.05, maxval = 1.0, step = 0.01, group = grpEngines)

grpScore = "3. Opportunity Monitor & 0–10 Scoring"
scoreThreshold10  = input.int(8, "Minimum Quality Score (0–10 Hypothesis)", minval = 5, maxval = 10, group = grpScore)
candExpiryBars    = input.int(6, "Candidate WAIT Expiration (Bars)", minval = 2, maxval = 20, group = grpScore)

grpRisk = "4. Risk, Position Sizing & Exit Model"
riskPct           = input.float(0.25, "Risk Per Trade (% of Equity)", minval = 0.05, maxval = 1.0, step = 0.05, group = grpRisk)
minRR             = input.float(1.5, "Minimum Reward-to-Risk Ratio", minval = 1.5, maxval = 4.0, step = 0.1, group = grpRisk)
targetRR          = input.float(1.8, "Default Fixed R:R Target", minval = 1.5, maxval = 5.0, step = 0.1, group = grpRisk)
maxDailyLossPct   = input.float(1.0, "Max Daily Loss (% of Reference Daily Equity)", minval = 0.25, maxval = 5.0, step = 0.25, group = grpRisk)
maxConsecLosses   = input.int(3, "Max Consecutive Losses per Day", minval = 1, maxval = 10, group = grpRisk)
stopBufferAtr     = input.float(0.25, "Structural Stop Buffer (x ATR)", minval = 0.05, maxval = 1.0, step = 0.05, group = grpRisk)
minStopAtr        = input.float(0.35, "Min Valid Stop Distance (x ATR)", minval = 0.15, maxval = 1.5, step = 0.05, group = grpRisk)
maxStopAtr        = input.float(3.5, "Max Valid Stop Distance (x ATR)", minval = 1.5, maxval = 8.0, step = 0.25, group = grpRisk)
exitModel         = input.string("STRUCTURAL_LEVEL", "Exit Model", options = ["FIXED_RR", "STRUCTURAL_LEVEL", "TRAIL_AFTER_1R"], group = grpRisk)

grpBroker = "5. Broker Contract & Cost Assumptions"
contractSizeOz    = input.float(100.0, "Ounces per 1.0 Standard Lot", minval = 1.0, maxval = 1000.0, group = grpBroker)
qtyUnitsPerOz     = input.float(1.0, "TradingView Qty Units per Ounce (1 for oz; 0.01 for 100-oz lots)", minval = 0.0001, maxval = 1000.0, group = grpBroker)
minTradableOz     = input.float(1.0, "Minimum Tradable Size (Oz, e.g. 0.01 lot = 1 oz)", minval = 0.01, maxval = 100.0, group = grpBroker)
sizeStepOz        = input.float(1.0, "Position Size Step (Oz)", minval = 0.01, maxval = 100.0, group = grpBroker)
estSpreadUsd      = input.float(0.16, "Estimated Full Round-Trip Spread ($/oz)", minval = 0.0, maxval = 2.0, step = 0.02, group = grpBroker)
estSlippageUsd    = input.float(0.05, "Estimated Full Round-Trip Slippage ($/oz)", minval = 0.0, maxval = 1.0, step = 0.01, group = grpBroker)
estCommPerOz      = input.float(0.07, "Estimated Round-Trip Commission ($/oz)", minval = 0.0, maxval = 1.0, step = 0.01, group = grpBroker)

grpSession = "6. Sessions, Date Window & Manual Event Risk"
allowAsian        = input.bool(false, "Allow Asian Session", group = grpSession)
asianSession      = input.session("0000-0700:23456", "Asian Session (UTC)", group = grpSession)
allowLondon       = input.bool(true, "Allow London Session", group = grpSession)
londonSession     = input.session("0700-1300:23456", "London Local Session (Europe/London; DST-aware)", group = grpSession)
allowNewYork      = input.bool(true, "Allow New York Session", group = grpSession)
newYorkSession    = input.session("0800-1600:23456", "New York Local Session (America/New_York; DST-aware)", group = grpSession)
useDateFilter     = input.bool(false, "Filter by Backtest Date Range", group = grpSession)
startTime         = input.time(timestamp("2024-01-01T00:00:00Z"), "Start Time (UTC)", group = grpSession)
endTime           = input.time(timestamp("2027-12-31T23:59:00Z"), "End Time (UTC)", group = grpSession)
enableNewsBlock   = input.bool(false, "Use Manually Supplied Event Calendar (up to 5 UTC timestamps)", group = grpSession)
newsBufferMins    = input.int(30, "No-Trade Minutes Before/After Each Event", minval = 5, maxval = 120, group = grpSession)
newsEvent1        = input.time(timestamp("1970-01-01T00:00:00Z"), "Event 1 (UTC, zero disables)", group = grpSession)
newsEvent2        = input.time(timestamp("1970-01-01T00:00:00Z"), "Event 2 (UTC, zero disables)", group = grpSession)
newsEvent3        = input.time(timestamp("1970-01-01T00:00:00Z"), "Event 3 (UTC, zero disables)", group = grpSession)
newsEvent4        = input.time(timestamp("1970-01-01T00:00:00Z"), "Event 4 (UTC, zero disables)", group = grpSession)
newsEvent5        = input.time(timestamp("1970-01-01T00:00:00Z"), "Event 5 (UTC, zero disables)", group = grpSession)

// ============================================================================
// 2. HELPER FUNCTIONS & NON-REPAINTING HIGHER-TIMEFRAME DATA
// ============================================================================
f_adx(int len) =>
    [_, _, adxVal] = ta.dmi(len, len)
    adxVal

f_htfPack() =>
    float hAtr  = ta.atr(atrLen)
    float hAdx  = f_adx(adxLen)
    float hEma  = ta.ema(close, emaLen)
    float pHigh = ta.pivothigh(high, pivotLeft, pivotRight)
    float pLow  = ta.pivotlow(low, pivotLeft, pivotRight)
    [close[1], high[1], low[1], hAtr[1], hAdx[1], hEma[1], pHigh[1], pLow[1]]

// Confirmed M15 values only (barmerge.lookahead_off + [1] on HTF series prevents any intrabar repainting)
[m15Close, m15High, m15Low, m15Atr, m15Adx, m15Ema, m15PivotH, m15PivotL] = request.security(
     syminfo.tickerid, regimeTf, f_htfPack(), barmerge.gaps_off, barmerge.lookahead_off)

var float lastM15High = na
var float prevM15High = na
var float lastM15Low  = na
var float prevM15Low  = na

if not na(m15PivotH) and (na(lastM15High) or m15PivotH != lastM15High)
    prevM15High := lastM15High
    lastM15High := m15PivotH

if not na(m15PivotL) and (na(lastM15Low) or m15PivotL != lastM15Low)
    prevM15Low := lastM15Low
    lastM15Low := m15PivotL

// M5 Indicators & Confirmed Swings
float atr5       = ta.atr(atrLen)
float medianAtr5 = ta.percentile_linear_interpolation(atr5, 60, 50)
float atrRatio   = medianAtr5 > 0 ? atr5 / medianAtr5 : 1.0
float adx5       = f_adx(adxLen)
float ema5       = ta.ema(close, emaLen)

// Confirmed M5 pivots (only known after pivotRight bars have closed)
float m5PivotH = ta.pivothigh(high, pivotLeft, pivotRight)
float m5PivotL = ta.pivotlow(low, pivotLeft, pivotRight)

var float lastSwingHigh     = na
var float prevSwingHigh     = na
var int   lastSwingHighBar  = na
var float lastSwingLow      = na
var float prevSwingLow      = na
var int   lastSwingLowBar   = na

if not na(m5PivotH)
    prevSwingHigh    := lastSwingHigh
    lastSwingHigh    := m5PivotH
    lastSwingHighBar := bar_index - pivotRight

if not na(m5PivotL)
    prevSwingLow    := lastSwingLow
    lastSwingLow    := m5PivotL
    lastSwingLowBar := bar_index - pivotRight

// Lower-timeframe micro pivots are only published after their configured right bars close.
float microPivotH = ta.pivothigh(high, microPivotLeft, microPivotRight)
float microPivotL = ta.pivotlow(low, microPivotLeft, microPivotRight)
var float lastMicroHigh = na
var float lastMicroLow = na
var int lastMicroHighBar = na
var int lastMicroLowBar = na
if not na(microPivotH)
    lastMicroHigh := microPivotH
    lastMicroHighBar := bar_index - microPivotRight
if not na(microPivotL)
    lastMicroLow := microPivotL
    lastMicroLowBar := bar_index - microPivotRight

// ============================================================================
// 3. ADAPTIVE 4-STATE MARKET-REGIME CLASSIFIER
// ============================================================================
// States: 1 = BULLISH_TREND, -1 = BEARISH_TREND, 0 = RANGE, 99 = UNCERTAIN_HIGH_VOL
bool m15HH = not na(lastM15High) and not na(prevM15High) and lastM15High > prevM15High
bool m15HL = not na(lastM15Low)  and not na(prevM15Low)  and lastM15Low  > prevM15Low
bool m15LH = not na(lastM15High) and not na(prevM15High) and lastM15High < prevM15High
bool m15LL = not na(lastM15Low)  and not na(prevM15Low)  and lastM15Low  < prevM15Low

bool m15BosUp   = not na(lastM15High) and m15Close > lastM15High
bool m15BosDown = not na(lastM15Low)  and m15Close < lastM15Low

float rollingHigh48 = ta.highest(high, 48)[1]
float rollingLow48  = ta.lowest(low, 48)[1]
bool confirmedRangeSwings = not na(lastSwingHigh) and not na(lastSwingLow) and
     not na(lastSwingHighBar) and not na(lastSwingLowBar) and
     bar_index - lastSwingHighBar <= 48 and bar_index - lastSwingLowBar <= 48 and
     lastSwingHigh > lastSwingLow
float rangeHigh48 = confirmedRangeSwings ? lastSwingHigh : rollingHigh48
float rangeLow48  = confirmedRangeSwings ? lastSwingLow : rollingLow48
float rangeWidthAtr = atr5 > 0 ? (rangeHigh48 - rangeLow48) / atr5 : 0.0

bool abnormalVol = atrRatio > highVolAtrMult or atrRatio < lowVolAtrMult or (m15HH and m15LL)
bool bullStruct  = (m15HH and m15HL) or m15BosUp
bool bearStruct  = (m15LH and m15LL) or m15BosDown

int regimeState = 99
string regimeName = "UNCERTAIN_HIGH_VOL"
if abnormalVol
    regimeState := 99
    regimeName  := "UNCERTAIN_HIGH_VOL"
else if bullStruct and not bearStruct and m15Close >= m15Ema and m15Adx >= trendAdxMin
    regimeState := 1
    regimeName  := "BULLISH_TREND"
else if bearStruct and not bullStruct and m15Close <= m15Ema and m15Adx >= trendAdxMin
    regimeState := -1
    regimeName  := "BEARISH_TREND"
else if rangeWidthAtr >= minRangeWidthAtr and rangeWidthAtr <= maxRangeWidthAtr and m15Adx <= (rangeAdxMax + 4.0)
    regimeState := 0
    regimeName  := "RANGE"
else if bullStruct and m15Close >= m15Ema
    regimeState := 1
    regimeName  := "BULLISH_TREND"
else if bearStruct and m15Close <= m15Ema
    regimeState := -1
    regimeName  := "BEARISH_TREND"
else if m15Adx < rangeAdxMax
    regimeState := 0
    regimeName  := "RANGE"

// ============================================================================
// 4. DAILY LOSS LIMIT, CONSECUTIVE LOSSES, SESSIONS & EVENT FILTER
// ============================================================================
var int   currentDay       = na
var float dayStartEquity   = strategy.initial_capital
var int   consecLosses     = 0
var int   lastClosedCount  = 0
var string lastTradedKey   = ""

int barDay = year(time_close, "UTC") * 10000 + month(time_close, "UTC") * 100 + dayofmonth(time_close, "UTC")
if na(currentDay) or barDay != currentDay
    currentDay     := barDay
    // Reference equity is strategy equity at the first completed UTC bar of each day.
    // It includes any open-position mark-to-market at that time; no intraday reset on month changes.
    dayStartEquity := strategy.equity

if strategy.closedtrades > lastClosedCount
    float lastProfit = strategy.closedtrades.profit(strategy.closedtrades - 1)
    consecLosses    := lastProfit < 0 ? consecLosses + 1 : 0
    lastClosedCount := strategy.closedtrades

float dailyLossPct = dayStartEquity > 0 ? math.max(0.0, (dayStartEquity - strategy.equity) / dayStartEquity * 100.0) : 0.0
bool dailyLocked   = dailyLossPct >= maxDailyLossPct or consecLosses >= maxConsecLosses

bool inAsian   = not na(time(timeframe.period, asianSession, "Etc/UTC"))
bool inLondon  = not na(time(timeframe.period, londonSession, "Europe/London"))
bool inNewYork = not na(time(timeframe.period, newYorkSession, "America/New_York"))
bool sessionOk = (inAsian and allowAsian) or (inLondon and allowLondon) or (inNewYork and allowNewYork)
bool dateOk    = not useDateFilter or (time_close >= startTime and time_close <= endTime)
bool inNewsBlock = enableNewsBlock and (
     (newsEvent1 > 0 and math.abs(time_close - newsEvent1) <= newsBufferMins * 60000) or
     (newsEvent2 > 0 and math.abs(time_close - newsEvent2) <= newsBufferMins * 60000) or
     (newsEvent3 > 0 and math.abs(time_close - newsEvent3) <= newsBufferMins * 60000) or
     (newsEvent4 > 0 and math.abs(time_close - newsEvent4) <= newsBufferMins * 60000) or
     (newsEvent5 > 0 and math.abs(time_close - newsEvent5) <= newsBufferMins * 60000))

bool isGoldChart = str.contains(str.upper(syminfo.ticker), "XAU") or str.contains(str.upper(syminfo.description), "GOLD")
bool chartTfOk = timeframe.isminutes and timeframe.multiplier == 5
bool regimeTfOk = timeframe.in_seconds(regimeTf) > timeframe.in_seconds(timeframe.period)
bool historyReady = bar_index >= 1499
float roundTripCostPerOz = estSpreadUsd + estSlippageUsd + estCommPerOz
int execScore = (not dailyLocked and sessionOk and not inNewsBlock and dateOk and atr5 > 0 and chartTfOk and isGoldChart) ? (estSpreadUsd / atr5 <= 0.12 ? 2 : 1) : 0

// ============================================================================
// 5. THREE INDEPENDENT TRADING ENGINES (A, B, C) & OPPORTUNITY MONITOR
// ============================================================================
float barRange = math.max(high - low, syminfo.mintick)
float bodyAbs  = math.abs(close - open)
float dispFrac = bodyAbs / barRange

// --- ENGINE A: Trend Continuation ---
bool aBullRegime   = enableEngineA and regimeState == 1 and not na(lastSwingHigh) and not na(prevSwingHigh) and not na(lastSwingLow) and not na(prevSwingLow)
float aImpulseTop  = aBullRegime ? math.max(lastSwingHigh, ta.highest(high, 12)[1]) : na
float aImpulseLegL = aBullRegime ? (aImpulseTop - lastSwingLow) : 0.0
bool aBosUp        = aBullRegime and lastSwingHigh >= prevSwingHigh + minSwingProgressAtr * atr5
bool aHlPreserved  = aBullRegime and lastSwingLow >= prevSwingLow + minSwingProgressAtr * atr5 and low > lastSwingLow
bool aImpulseOkL   = aBullRegime and aImpulseLegL >= minImpulseAtr * atr5
float aPullLow     = ta.lowest(low, 6)
float aRetraceL    = aImpulseLegL > 0 ? (aImpulseTop - aPullLow) / aImpulseLegL : 0.0
bool aInZoneL      = aBullRegime and ((aRetraceL >= minPullbackFib and aRetraceL <= maxPullbackFib) or math.abs(aPullLow - prevSwingHigh) <= pullbackZoneAtrTol * atr5)
bool aRejectL      = close > open and (dispFrac >= minDispRatio or (math.min(open, close) - low) / barRange >= minRejectionWick)
float aMicroLevelL = lastMicroHigh
bool aMicroBreakL  = not na(aMicroLevelL) and close > aMicroLevelL and (close - aMicroLevelL) <= maxChaseAtr * atr5
bool aCandLong     = aBullRegime and aBosUp and aHlPreserved and aImpulseOkL and aInZoneL
bool aConfLong     = aCandLong and aRejectL and aMicroBreakL

bool aBearRegime   = enableEngineA and regimeState == -1 and not na(lastSwingLow) and not na(prevSwingLow) and not na(lastSwingHigh) and not na(prevSwingHigh)
float aImpulseBot  = aBearRegime ? math.min(lastSwingLow, ta.lowest(low, 12)[1]) : na
float aImpulseLegS = aBearRegime ? (lastSwingHigh - aImpulseBot) : 0.0
bool aBosDown      = aBearRegime and lastSwingLow <= prevSwingLow - minSwingProgressAtr * atr5
bool aLhPreserved  = aBearRegime and lastSwingHigh <= prevSwingHigh - minSwingProgressAtr * atr5 and high < lastSwingHigh
bool aImpulseOkS   = aBearRegime and aImpulseLegS >= minImpulseAtr * atr5
float aPullHigh    = ta.highest(high, 6)
float aRetraceS    = aImpulseLegS > 0 ? (aPullHigh - aImpulseBot) / aImpulseLegS : 0.0
bool aInZoneS      = aBearRegime and ((aRetraceS >= minPullbackFib and aRetraceS <= maxPullbackFib) or math.abs(aPullHigh - prevSwingLow) <= pullbackZoneAtrTol * atr5)
bool aRejectS      = close < open and (dispFrac >= minDispRatio or (high - math.max(open, close)) / barRange >= minRejectionWick)
float aMicroLevelS = lastMicroLow
bool aMicroBreakS  = not na(aMicroLevelS) and close < aMicroLevelS and (aMicroLevelS - close) <= maxChaseAtr * atr5
bool aCandShort    = aBearRegime and aBosDown and aLhPreserved and aImpulseOkS and aInZoneS
bool aConfShort    = aCandShort and aRejectS and aMicroBreakS

// --- ENGINE B: Liquidity Sweep & Reversal ---
var int   bBullSweepBar   = na
var float bBullSweepLevel = na
var float bBullSweepLow   = na
var float bBullMicroHigh  = na

if enableEngineB and not na(lastSwingLow) and regimeState != -1
    float sweepDepthL = atr5 > 0 ? (lastSwingLow - low) / atr5 : 0.0
    if sweepDepthL >= minSweepAtr and sweepDepthL <= maxSweepAtr and close > lastSwingLow
        bBullSweepBar   := bar_index
        bBullSweepLevel := lastSwingLow
        bBullSweepLow   := low
        bBullMicroHigh  := ta.highest(high, 4)[1]

bool bBullActive = enableEngineB and not na(bBullSweepBar) and (bar_index - bBullSweepBar) <= mssWindowBars and low >= bBullSweepLow and close > bBullSweepLevel
bool bBullMss    = bBullActive and bar_index > bBullSweepBar and close > bBullMicroHigh and close > open and dispFrac >= minDispRatio
bool bBullRetest = not requireRetestB or (low <= bBullMicroHigh + retestToleranceAtr * atr5 and close > bBullMicroHigh)
bool bConfLong   = bBullMss and bBullRetest

var int   bBearSweepBar   = na
var float bBearSweepLevel = na
var float bBearSweepHigh  = na
var float bBearMicroLow   = na

if enableEngineB and not na(lastSwingHigh) and regimeState != 1
    float sweepDepthS = atr5 > 0 ? (high - lastSwingHigh) / atr5 : 0.0
    if sweepDepthS >= minSweepAtr and sweepDepthS <= maxSweepAtr and close < lastSwingHigh
        bBearSweepBar   := bar_index
        bBearSweepLevel := lastSwingHigh
        bBearSweepHigh  := high
        bBearMicroLow   := ta.lowest(low, 4)[1]

bool bBearActive = enableEngineB and not na(bBearSweepBar) and (bar_index - bBearSweepBar) <= mssWindowBars and high <= bBearSweepHigh and close < bBearSweepLevel
bool bBearMss    = bBearActive and bar_index > bBearSweepBar and close < bBearMicroLow and close < open and dispFrac >= minDispRatio
bool bBearRetest = not requireRetestB or (high >= bBearMicroLow - retestToleranceAtr * atr5 and close < bBearMicroLow)
bool bConfShort  = bBearMss and bBearRetest

// --- ENGINE C: Range & Mean-Reversion ---
bool cValidRange = enableEngineC and regimeState == 0 and rangeWidthAtr >= minRangeWidthAtr and rangeWidthAtr <= maxRangeWidthAtr and close <= rangeHigh48 + rangeBreakoutAtr * atr5 and close >= rangeLow48 - rangeBreakoutAtr * atr5
float cLoc       = cValidRange and (rangeHigh48 > rangeLow48) ? (close - rangeLow48) / (rangeHigh48 - rangeLow48) : 0.5
// Strictly prohibit the configurable middle zone (default 25%..75%).
bool cInMiddle   = cLoc >= rangeMidLowFrac and cLoc <= rangeMidHighFrac
bool cNearLow    = cValidRange and not cInMiddle and (cLoc <= rangeZoneFrac or (low <= rangeLow48 + rangeEntryWickAtr * atr5 and close > rangeLow48))
bool cNearHigh   = cValidRange and not cInMiddle and (cLoc >= (1.0 - rangeZoneFrac) or (high >= rangeHigh48 - rangeEntryWickAtr * atr5 and close < rangeHigh48))
bool cConfLong   = cNearLow  and close > open and close > high[1]
bool cConfShort  = cNearHigh and close < open and close < low[1]

// One auditable active WAIT candidate at a time. It persists across bars, then expires or is
// invalidated; confirmed entries are still evaluated only on the current closed M5 bar.
var int trackedStartBar = na
var int trackedExpiryBars = na
var int trackedDirection = 0
var string trackedEngine = ""
var string trackedSetupKey = ""
var float trackedLevel = na
var float trackedInvalidation = na
var float trackedStop = na
var int trackedStructureScore = 0
var int trackedLevelScore = 0
var int trackedConfirmScore = 0
var string trackedMissing = ""

bool trackedInvalid = not na(trackedStartBar) and not na(trackedInvalidation) and
     (trackedDirection == 1 ? low <= trackedInvalidation : high >= trackedInvalidation)
bool trackedExpired = not na(trackedStartBar) and not na(trackedExpiryBars) and
     bar_index - trackedStartBar > trackedExpiryBars
if trackedInvalid or trackedExpired
    trackedStartBar := na
    trackedExpiryBars := na
    trackedDirection := 0
    trackedEngine := ""
    trackedSetupKey := ""
    trackedLevel := na
    trackedInvalidation := na
    trackedStop := na
    trackedStructureScore := 0
    trackedLevelScore := 0
    trackedConfirmScore := 0
    trackedMissing := ""

// ============================================================================
// 6. CANDIDATE SELECTION, 0–10 SCORING & POSITION SIZING
// ============================================================================
string activeEngine = "NONE"
string stateLabel   = "NO-TRADE"
int    dir          = 0
float  entryPrice   = close
float  stopPrice    = na
float  targetPrice  = na
float  structLevel  = na
string setupKey     = ""
int    scoreStruct  = 0
int    scoreLevel   = 0
int    scoreConf    = 0
float  invalidationLevel = na
string missingConditions = ""
int    candidateExpiry = candExpiryBars
int    candidateStartBar = bar_index

if aConfLong or aCandLong
    activeEngine := "ENGINE_A_TREND"
    dir          := 1
    structLevel  := prevSwingHigh
    stopPrice    := math.min(aPullLow, lastSwingLow) - stopBufferAtr * atr5
    scoreStruct  := 2
    scoreLevel   := math.abs(aPullLow - prevSwingHigh) <= 0.60 * atr5 ? 2 : 1
    scoreConf    := aConfLong ? 2 : 1
    invalidationLevel := lastSwingLow
    stateLabel   := aConfLong ? "BUY" : "WAIT"
    missingConditions := aConfLong ? "" : "انتظار ریجکشن/دیسپلیسمنت و شکست پیوت خرد M5"
    setupKey     := "A_L_" + str.tostring(lastSwingLowBar)
else if aConfShort or aCandShort
    activeEngine := "ENGINE_A_TREND"
    dir          := -1
    structLevel  := prevSwingLow
    stopPrice    := math.max(aPullHigh, lastSwingHigh) + stopBufferAtr * atr5
    scoreStruct  := 2
    scoreLevel   := math.abs(aPullHigh - prevSwingLow) <= 0.60 * atr5 ? 2 : 1
    scoreConf    := aConfShort ? 2 : 1
    invalidationLevel := lastSwingHigh
    stateLabel   := aConfShort ? "SELL" : "WAIT"
    missingConditions := aConfShort ? "" : "انتظار ریجکشن/دیسپلیسمنت و شکست پیوت خرد M5"
    setupKey     := "A_S_" + str.tostring(lastSwingHighBar)
else if bConfLong or bBullActive
    activeEngine := "ENGINE_B_SWEEP"
    dir          := 1
    structLevel  := bBullSweepLevel
    stopPrice    := bBullSweepLow - stopBufferAtr * atr5
    scoreStruct  := regimeState == 1 or regimeState == 0 ? 2 : 1
    scoreLevel   := 2
    scoreConf    := bConfLong ? 2 : 1
    invalidationLevel := bBullSweepLow
    candidateExpiry := mssWindowBars
    candidateStartBar := bBullSweepBar
    stateLabel   := bConfLong ? "BUY" : "WAIT"
    missingConditions := bConfLong ? "" : "انتظار MSS صعودی و کندل دیسپلیسمنت"
    setupKey     := "B_L_" + str.tostring(bBullSweepBar)
else if bConfShort or bBearActive
    activeEngine := "ENGINE_B_SWEEP"
    dir          := -1
    structLevel  := bBearSweepLevel
    stopPrice    := bBearSweepHigh + stopBufferAtr * atr5
    scoreStruct  := regimeState == -1 or regimeState == 0 ? 2 : 1
    scoreLevel   := 2
    scoreConf    := bConfShort ? 2 : 1
    invalidationLevel := bBearSweepHigh
    candidateExpiry := mssWindowBars
    candidateStartBar := bBearSweepBar
    stateLabel   := bConfShort ? "SELL" : "WAIT"
    missingConditions := bConfShort ? "" : "انتظار MSS نزولی و کندل دیسپلیسمنت"
    setupKey     := "B_S_" + str.tostring(bBearSweepBar)
else if cConfLong or cNearLow
    activeEngine := "ENGINE_C_RANGE"
    dir          := 1
    structLevel  := rangeLow48
    stopPrice    := math.min(rangeLow48, low) - stopBufferAtr * atr5
    scoreStruct  := 2
    scoreLevel   := 2
    scoreConf    := cConfLong ? 2 : 0
    invalidationLevel := rangeLow48
    stateLabel   := cConfLong ? "BUY" : "WAIT"
    missingConditions := cConfLong ? "" : "انتظار ریجکشن صعودی/شکست سقف کندل قبل"
    setupKey     := "C_L_" + str.tostring(math.round(rangeLow48))
else if cConfShort or cNearHigh
    activeEngine := "ENGINE_C_RANGE"
    dir          := -1
    structLevel  := rangeHigh48
    stopPrice    := math.max(rangeHigh48, high) + stopBufferAtr * atr5
    scoreStruct  := 2
    scoreLevel   := 2
    scoreConf    := cConfShort ? 2 : 0
    invalidationLevel := rangeHigh48
    stateLabel   := cConfShort ? "SELL" : "WAIT"
    missingConditions := cConfShort ? "" : "انتظار ریجکشن نزولی/شکست کف کندل قبل"
    setupKey     := "C_S_" + str.tostring(math.round(rangeHigh48))

// If the price has left the immediate trigger area but the candidate is still alive,
// keep displaying WAIT with the original structural stop and invalidation level.
if dir == 0 and not na(trackedStartBar) and bar_index - trackedStartBar <= trackedExpiryBars
    activeEngine := trackedEngine
    dir := trackedDirection
    structLevel := trackedLevel
    invalidationLevel := trackedInvalidation
    stopPrice := trackedStop
    setupKey := trackedSetupKey
    scoreStruct := trackedStructureScore
    scoreLevel := trackedLevelScore
    scoreConf := trackedConfirmScore
    missingConditions := trackedMissing
    candidateExpiry := trackedExpiryBars
    stateLabel := "WAIT"

float stopDist = not na(stopPrice) ? math.abs(entryPrice - stopPrice) : na
bool validStop = not na(stopDist) and atr5 > 0 and stopDist >= minStopAtr * atr5 and stopDist <= maxStopAtr * atr5 and (dir == 1 ? stopPrice < entryPrice : dir == -1 ? stopPrice > entryPrice : false)

if validStop and dir != 0
    float fixedTarget = dir == 1 ? entryPrice + targetRR * stopDist : entryPrice - targetRR * stopDist
    float knownOpposingLevel = dir == 1 ? lastSwingHigh : lastSwingLow
    bool canUseKnownLevel = not na(knownOpposingLevel) and (dir == 1 ? knownOpposingLevel >= entryPrice + minRR * stopDist : knownOpposingLevel <= entryPrice - minRR * stopDist)
    float structuralTarget = activeEngine == "ENGINE_C_RANGE" ? (dir == 1 ? rangeHigh48 - rangeTargetAtr * atr5 : rangeLow48 + rangeTargetAtr * atr5) : (canUseKnownLevel ? knownOpposingLevel : fixedTarget)
    targetPrice := exitModel == "STRUCTURAL_LEVEL" ? structuralTarget : fixedTarget

bool validTarget = not na(targetPrice) and (dir == 1 ? targetPrice > entryPrice : dir == -1 ? targetPrice < entryPrice : false)
float grossRR = (validStop and validTarget and stopDist > 0) ? math.abs(targetPrice - entryPrice) / stopDist : 0.0
float netRR   = (validStop and validTarget) ? math.max(0.0, math.abs(targetPrice - entryPrice) - roundTripCostPerOz) / math.max(1e-6, stopDist + roundTripCostPerOz) : 0.0
int   scoreRR = netRR >= 2.0 ? 2 : (netRR >= minRR ? 1 : 0)
int   totalScore10 = scoreStruct + scoreLevel + scoreConf + scoreRR + execScore

// Persist an incomplete opportunity until it confirms, violates its structure, or expires.
if stateLabel == "WAIT" and dir != 0 and validStop and not na(targetPrice) and setupKey != ""
    if na(trackedStartBar) or trackedSetupKey != setupKey
        trackedStartBar := candidateStartBar
        trackedExpiryBars := candidateExpiry
        trackedDirection := dir
        trackedEngine := activeEngine
        trackedSetupKey := setupKey
        trackedLevel := structLevel
        trackedInvalidation := invalidationLevel
        trackedStop := stopPrice
        trackedStructureScore := scoreStruct
        trackedLevelScore := scoreLevel
        trackedConfirmScore := scoreConf
        trackedMissing := missingConditions
    else
        trackedStop := stopPrice
        trackedMissing := missingConditions
        trackedConfirmScore := scoreConf

// Position size in ounces from actual stop distance + transaction costs and 0.25% equity risk
float riskBudgetUsd = strategy.equity * (riskPct / 100.0)
float rawOz         = validStop ? riskBudgetUsd / (stopDist + roundTripCostPerOz) : 0.0
float steppedOz     = math.floor(rawOz / sizeStepOz) * sizeStepOz
float finalQtyOz    = steppedOz >= minTradableOz ? steppedOz : 0.0

// Hard overrides must pass before BUY/SELL can execute
bool hardGatesOk = validStop and validTarget and grossRR >= minRR and netRR >= minRR and totalScore10 >= scoreThreshold10 and finalQtyOz >= minTradableOz and (estSpreadUsd / math.max(atr5, syminfo.mintick)) <= maxSpreadAtrRatio and not dailyLocked and sessionOk and not inNewsBlock and dateOk and chartTfOk and regimeTfOk and isGoldChart and historyReady and not na(m15Close) and not na(m15Adx) and regimeState != 99 and setupKey != lastTradedKey and strategy.position_size == 0

string gateReason = ""
if not isGoldChart
    gateReason := "Chart must be XAU/USD or a Gold ticker"
else if not chartTfOk
    gateReason := "Switch chart to M5; entries on other chart timeframes are disabled"
else if not regimeTfOk
    gateReason := "Regime timeframe must be higher than M5 (default M15)"
else if not historyReady
    gateReason := "Need at least 1,500 chart bars for the initial warm-up"
else if na(m15Close) or na(m15Adx)
    gateReason := "Confirmed M15 regime data is unavailable"
else if regimeState == 99
    gateReason := "Uncertain / abnormal-volatility regime"
else if dailyLocked
    gateReason := "Daily loss or consecutive-loss lock is active"
else if not sessionOk
    gateReason := "Outside configured London / New York / Asian sessions"
else if inNewsBlock
    gateReason := "Manual economic-event blackout is active"
else if not dateOk
    gateReason := "Outside configured backtest date range"
else if atr5 <= 0 or not validStop
    gateReason := "Invalid or excessively wide structural stop"
else if not validTarget
    gateReason := "Target is not beyond entry in the trade direction"
else if netRR < minRR
    gateReason := "Net reward-to-risk after modeled costs is below the minimum"
else if totalScore10 < scoreThreshold10
    gateReason := "Quality score is below threshold"
else if finalQtyOz < minTradableOz
    gateReason := "Position size is below broker minimum size"
else if (estSpreadUsd / math.max(atr5, syminfo.mintick)) > maxSpreadAtrRatio
    gateReason := "Spread / ATR exceeds the hard execution cap"
else if setupKey == lastTradedKey
    gateReason := "Duplicate entry for the same structural setup"
else if strategy.position_size != 0
    gateReason := "A position is already open; stacking is disabled"

if (stateLabel == "BUY" or stateLabel == "SELL") and not hardGatesOk
    stateLabel := "NO-TRADE"
    missingConditions := gateReason

// ============================================================================
// 7. ORDER EXECUTION & OPTIONAL 1R TRAILING MANAGEMENT
// ============================================================================
var float activeEntry = na
var float activeStop  = na
var float activeTp    = na

if barstate.isconfirmed
    if stateLabel == "BUY" and hardGatesOk
        strategy.entry("ALS5_LONG", strategy.long, qty = finalQtyOz * qtyUnitsPerOz, comment = activeEngine + " [" + str.tostring(totalScore10) + "/10]")
        strategy.exit("ALS5_LONG_EXIT", from_entry = "ALS5_LONG", stop = stopPrice, limit = targetPrice)
        activeEntry   := entryPrice
        activeStop    := stopPrice
        activeTp      := targetPrice
        lastTradedKey := setupKey
        trackedStartBar := na
        trackedExpiryBars := na
        trackedDirection := 0
        trackedSetupKey := ""
    else if stateLabel == "SELL" and hardGatesOk
        strategy.entry("ALS5_SHORT", strategy.short, qty = finalQtyOz * qtyUnitsPerOz, comment = activeEngine + " [" + str.tostring(totalScore10) + "/10]")
        strategy.exit("ALS5_SHORT_EXIT", from_entry = "ALS5_SHORT", stop = stopPrice, limit = targetPrice)
        activeEntry   := entryPrice
        activeStop    := stopPrice
        activeTp      := targetPrice
        lastTradedKey := setupKey
        trackedStartBar := na
        trackedExpiryBars := na
        trackedDirection := 0
        trackedSetupKey := ""

    // Optional break-even trail after +1R favorable excursion when TRAIL_AFTER_1R is selected
    if exitModel == "TRAIL_AFTER_1R" and strategy.position_size != 0 and not na(activeEntry) and not na(activeStop)
        float initRisk = math.abs(activeEntry - activeStop)
        if strategy.position_size > 0 and high >= activeEntry + initRisk and activeStop < activeEntry
            activeStop := activeEntry
            strategy.exit("ALS5_LONG_EXIT", from_entry = "ALS5_LONG", stop = activeStop, limit = activeTp)
        if strategy.position_size < 0 and low <= activeEntry - initRisk and activeStop > activeEntry
            activeStop := activeEntry
            strategy.exit("ALS5_SHORT_EXIT", from_entry = "ALS5_SHORT", stop = activeStop, limit = activeTp)

// ============================================================================
// 8. VISUAL OVERLAYS & HUD MONITOR TABLE
// ============================================================================
plot(ema5, "M5 EMA 50", color = color.new(color.aqua, 35), linewidth = 1)
plot(regimeState == 0 ? rangeHigh48 : na, "Range High", color = color.new(color.orange, 25), style = plot.style_linebr)
plot(regimeState == 0 ? rangeLow48  : na, "Range Low",  color = color.new(color.teal, 25),   style = plot.style_linebr)

plotshape(stateLabel == "BUY"  and barstate.isconfirmed, title = "ALS-5 BUY",  style = shape.triangleup,   location = location.belowbar, color = color.lime,   size = size.small, text = "ALS-5 BUY")
plotshape(stateLabel == "SELL" and barstate.isconfirmed, title = "ALS-5 SELL", style = shape.triangledown, location = location.abovebar, color = color.red,    size = size.small, text = "ALS-5 SELL")
plotshape(stateLabel == "WAIT" and barstate.isconfirmed, title = "ALS-5 WAIT", style = shape.circle,       location = location.abovebar, color = color.yellow, size = size.tiny)

string monitorReason = missingConditions != "" ? missingConditions : (stateLabel == "NO-TRADE" ? (gateReason != "" ? gateReason : "No qualifying candidate in Engine A/B/C") : "All mandatory entry conditions confirmed")
int candidateBarsLeft = not na(trackedStartBar) and not na(trackedExpiryBars) ? math.max(0, trackedExpiryBars - (bar_index - trackedStartBar)) : stateLabel == "WAIT" ? candidateExpiry : 0
var table hud = table.new(position.top_right, 2, 9, bgcolor = color.new(color.black, 20), border_width = 1)
if barstate.islast
    table.cell(hud, 0, 0, "ALS-5 System", text_color = color.white, bgcolor = color.new(color.blue, 30))
    table.cell(hud, 1, 0, stateLabel, text_color = stateLabel == "BUY" ? color.lime : stateLabel == "SELL" ? color.red : stateLabel == "WAIT" ? color.yellow : color.silver)
    table.cell(hud, 0, 1, "M15 Regime", text_color = color.silver)
    table.cell(hud, 1, 1, regimeName, text_color = color.white)
    table.cell(hud, 0, 2, "Active Engine", text_color = color.silver)
    table.cell(hud, 1, 2, activeEngine, text_color = color.white)
    table.cell(hud, 0, 3, "Quality Score", text_color = color.silver)
    table.cell(hud, 1, 3, str.tostring(totalScore10) + " / 10 (S:" + str.tostring(scoreStruct) + " L:" + str.tostring(scoreLevel) + " C:" + str.tostring(scoreConf) + " R:" + str.tostring(scoreRR) + " E:" + str.tostring(execScore) + ")", text_color = color.white)
    table.cell(hud, 0, 4, "Gross / Net R:R", text_color = color.silver)
    table.cell(hud, 1, 4, str.tostring(grossRR, "#.##") + " / " + str.tostring(netRR, "#.##"), text_color = color.white)
    table.cell(hud, 0, 5, "Position Size (Oz)", text_color = color.silver)
    table.cell(hud, 1, 5, str.tostring(finalQtyOz, "#.##") + " oz (" + str.tostring(finalQtyOz / contractSizeOz, "#.##") + " lots)", text_color = color.white)
    table.cell(hud, 0, 6, "Daily Loss / Locks", text_color = color.silver)
    table.cell(hud, 1, 6, str.tostring(dailyLossPct, "#.##") + "% / ConsecL=" + str.tostring(consecLosses), text_color = dailyLocked ? color.red : color.lime)
    table.cell(hud, 0, 7, "Level / Invalidation / Expiry", text_color = color.silver)
    table.cell(hud, 1, 7, (not na(structLevel) ? str.tostring(structLevel, "#.##") : "—") + " / " + (not na(invalidationLevel) ? str.tostring(invalidationLevel, "#.##") : "—") + " / " + str.tostring(candidateBarsLeft) + " bars", text_color = color.white)
    table.cell(hud, 0, 8, "Missing / No-Trade Reason", text_color = color.silver)
    table.cell(hud, 1, 8, monitorReason, text_color = stateLabel == "WAIT" or stateLabel == "NO-TRADE" ? color.yellow : color.lime)
