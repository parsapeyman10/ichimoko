//@lipi=2
// BASE_ICHIMOKU Lite audit for a standard 15-minute GoCharting chart only.
//
// Timeframes are deliberately limited to native 15m -> closed 30m -> closed 1H.
// Each real strategy entry draws a persisted entry, SL and TP bracket on chart.
// This is a low-cost diagnostic adaptation, NOT the original 4H/1H/15m model.
// Orders are simulated by GoCharting only; nothing is routed to an exchange.
strategy("BASE Ichimoku Lite bracket audit (15m / 30m / 1H)", overlay=true, initial_capital=1000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission_percent, commission_value=0.105, pyramiding=0, process_orders_on_close=false, max_lines_count=500, max_labels_count=500)

int TENKAN = input.int(9, "Tenkan", minval=2)
int KIJUN = input.int(26, "Kijun", minval=2)
int SPAN_B = input.int(52, "Senkou B", minval=2)
int DISPLACEMENT = input.int(26, "Displacement", minval=2)
float qty = input.float(1.0, "Backtest quantity", minval=0.000001, step=0.01)
bool allowLong = input.bool(true, "Enable long")
bool allowShort = input.bool(true, "Enable short")
bool showRawTriggers = input.bool(false, "DEBUG: show raw triggers rejected by gate")
bool debugVirtualTriggerTrades = input.bool(false, "DEBUG ONLY: simulate raw triggers")
float maxKijunExtensionAtr = input.float(1.80, "Max Kijun extension (ATR)", minval=0.50, step=0.05)
float slBufferAtr = input.float(0.25, "Structural SL buffer (ATR)", minval=0.15, step=0.01)
float roundTripCostPct = input.float(0.0021, "Round-trip cost fraction", minval=0.0, step=0.0001)
int maxHoldBars = input.int(20, "Time stop: 15m bars", minval=1)

type LiteSnap {
    bool ready
    float o
    float h
    float l
    float c
    float tenkan
    float kijun
    float prevTenkan
    float prevKijun
    float currentA
    float currentB
    float futureA
    float futureB
    float prevFutureA
    float prevFutureB
    float atr
    bool chikouBull
    bool chikouBear
    float chikouPeak
    float chikouTrough
    bool ssbFlat
    bool kijunFlat
    float body
    float clv
    float volumeRatio
    float er
    float upperWick
    float lowerWick
}

func arrMax(array<float> values, int first, int last) {
    float best = array.get(values, first)
    if last > first {
        for i = first + 1 to last {
            best := math.max(best, array.get(values, i))
        }
    }
    return best
}

func arrMin(array<float> values, int first, int last) {
    float best = array.get(values, first)
    if last > first {
        for i = first + 1 to last {
            best := math.min(best, array.get(values, i))
        }
    }
    return best
}

func midpoint(array<float> highs, array<float> lows, int at, int length) {
    int first = math.max(0, at - length + 1)
    return (arrMax(highs, first, at) + arrMin(lows, first, at)) / 2.0
}

func addClosedBar(array<float> opens, array<float> highs, array<float> lows, array<float> closes, array<float> volumes, float o, float h, float l, float c, float v) {
    array.push(opens, o)
    array.push(highs, h)
    array.push(lows, l)
    array.push(closes, c)
    array.push(volumes, v)
    if array.length(closes) > 80 {
        array.shift(opens)
        array.shift(highs)
        array.shift(lows)
        array.shift(closes)
        array.shift(volumes)
    }
}

// Called only when an aggregated 30m/1H bar has completed, never per 15m bar.
func makeSnapshot(array<float> opens, array<float> highs, array<float> lows, array<float> closes, array<float> volumes) {
    int n = array.length(closes)
    if n < SPAN_B + 5 {
        return LiteSnap.new(ready=false)
    }
    int last = n - 1
    int previous = last - 1
    int displaced = math.max(0, last - (DISPLACEMENT - 1))
    float t = midpoint(highs, lows, last, TENKAN)
    float k = midpoint(highs, lows, last, KIJUN)
    float previousT = midpoint(highs, lows, previous, TENKAN)
    float previousK = midpoint(highs, lows, previous, KIJUN)
    float currentA = (midpoint(highs, lows, displaced, TENKAN) + midpoint(highs, lows, displaced, KIJUN)) / 2.0
    float currentB = midpoint(highs, lows, displaced, SPAN_B)
    float futureA = (t + k) / 2.0
    float futureB = midpoint(highs, lows, last, SPAN_B)
    float previousFutureA = (previousT + previousK) / 2.0
    float previousFutureB = midpoint(highs, lows, previous, SPAN_B)

    int atrFirst = math.max(1, last - 13)
    float trSum = math.max(array.get(highs, atrFirst) - array.get(lows, atrFirst), math.max(math.abs(array.get(highs, atrFirst) - array.get(closes, atrFirst - 1)), math.abs(array.get(lows, atrFirst) - array.get(closes, atrFirst - 1))))
    if last > atrFirst {
        for i = atrFirst + 1 to last {
            float tr = math.max(array.get(highs, i) - array.get(lows, i), math.max(math.abs(array.get(highs, i) - array.get(closes, i - 1)), math.abs(array.get(lows, i) - array.get(closes, i - 1))))
            trSum += tr
        }
    }
    float c = array.get(closes, last)
    float atr = math.max(trSum / (last - atrFirst + 1), c * 0.0005)
    float topAtChikou = math.max(midpoint(highs, lows, displaced, TENKAN), midpoint(highs, lows, displaced, KIJUN))
    float bottomAtChikou = math.min(midpoint(highs, lows, displaced, TENKAN), midpoint(highs, lows, displaced, KIJUN))
    bool chikouBull = c > math.max(array.get(highs, displaced), topAtChikou)
    bool chikouBear = c < math.min(array.get(lows, displaced), bottomAtChikou)

    int peakFirst = math.max(0, last - KIJUN)
    float peak = array.get(closes, peakFirst)
    float trough = array.get(closes, peakFirst)
    if last - 1 > peakFirst {
        for i = peakFirst + 1 to last - 1 {
            peak := math.max(peak, array.get(closes, i))
            trough := math.min(trough, array.get(closes, i))
        }
    }

    float tolerance = math.max(c * 0.0003, atr * 0.04)
    float currentB1 = midpoint(highs, lows, math.max(0, displaced - 1), SPAN_B)
    float currentB2 = midpoint(highs, lows, math.max(0, displaced - 2), SPAN_B)
    bool ssbFlat = math.abs(currentB - currentB1) <= tolerance and math.abs(currentB - currentB2) <= tolerance
    bool kijunFlat = math.abs(k - previousK) <= tolerance
    float candleRange = math.max(array.get(highs, last) - array.get(lows, last), 0.00000001)
    float body = math.abs(c - array.get(opens, last)) / candleRange
    float clv = math.min(1.0, math.max(0.0, (c - array.get(lows, last)) / candleRange))

    int volumeFirst = math.max(0, last - 19)
    float volumeSum = array.get(volumes, volumeFirst)
    if last > volumeFirst {
        for i = volumeFirst + 1 to last {
            volumeSum += array.get(volumes, i)
        }
    }
    float averageVolume = volumeSum / (last - volumeFirst + 1)
    float volumeRatio = averageVolume > 0.0 and array.get(volumes, last) > 0.0 ? array.get(volumes, last) / averageVolume : 1.0

    int erFirst = math.max(0, last - 14)
    float erPath = 0.0
    if last > erFirst {
        for i = erFirst + 1 to last {
            erPath += math.abs(array.get(closes, i) - array.get(closes, i - 1))
        }
    }
    float er = erPath > 0.00000001 ? math.min(1.0, math.abs(c - array.get(closes, erFirst)) / erPath) : 0.5
    float upperWick = math.max(0.0, (array.get(highs, last) - math.max(array.get(opens, last), c)) / candleRange)
    float lowerWick = math.max(0.0, (math.min(array.get(opens, last), c) - array.get(lows, last)) / candleRange)

    return LiteSnap.new(ready=true, o=array.get(opens, last), h=array.get(highs, last), l=array.get(lows, last), c=c, tenkan=t, kijun=k, prevTenkan=previousT, prevKijun=previousK, currentA=currentA, currentB=currentB, futureA=futureA, futureB=futureB, prevFutureA=previousFutureA, prevFutureB=previousFutureB, atr=atr, chikouBull=chikouBull, chikouBear=chikouBear, chikouPeak=peak, chikouTrough=trough, ssbFlat=ssbFlat, kijunFlat=kijunFlat, body=body, clv=clv, volumeRatio=volumeRatio, er=er, upperWick=upperWick, lowerWick=lowerWick)
}

static array<float> o30 = array.new<float>(0)
static array<float> h30 = array.new<float>(0)
static array<float> l30 = array.new<float>(0)
static array<float> c30 = array.new<float>(0)
static array<float> v30 = array.new<float>(0)
static array<float> o1h = array.new<float>(0)
static array<float> h1h = array.new<float>(0)
static array<float> l1h = array.new<float>(0)
static array<float> c1h = array.new<float>(0)
static array<float> v1h = array.new<float>(0)
static LiteSnap snap30 = LiteSnap.new(ready=false)
static LiteSnap snap1h = LiteSnap.new(ready=false)
static int count30 = 0
static float bucket30Open = na
static float bucket30High = na
static float bucket30Low = na
static float bucket30Volume = 0.0
static int count1h = 0
static float bucket1hOpen = na
static float bucket1hHigh = na
static float bucket1hLow = na
static float bucket1hVolume = 0.0

bool chartIs15m = interval.isminutes and interval.multiplier == 15
bool closed15m = chartIs15m and barstate.isconfirmed
if closed15m {
    int utcMinute = minute(time, "UTC")
    // Build a 30m bucket only from :00+:15 or :30+:45.
    if utcMinute == 0 or utcMinute == 30 {
        bucket30Open := open
        bucket30High := high
        bucket30Low := low
        bucket30Volume := volume
        count30 := 1
    } else if count30 > 0 {
        bucket30High := math.max(bucket30High, high)
        bucket30Low := math.min(bucket30Low, low)
        bucket30Volume += volume
        count30 += 1
    }
    if utcMinute == 15 or utcMinute == 45 {
        if count30 == 2 {
            addClosedBar(o30, h30, l30, c30, v30, bucket30Open, bucket30High, bucket30Low, close, bucket30Volume)
            snap30 := makeSnapshot(o30, h30, l30, c30, v30)
        }
        count30 := 0
    }

    // Build a 1H bucket only from four complete 15m bars.
    if utcMinute == 0 {
        bucket1hOpen := open
        bucket1hHigh := high
        bucket1hLow := low
        bucket1hVolume := volume
        count1h := 1
    } else if count1h > 0 {
        bucket1hHigh := math.max(bucket1hHigh, high)
        bucket1hLow := math.min(bucket1hLow, low)
        bucket1hVolume += volume
        count1h += 1
    }
    if utcMinute == 45 {
        if count1h == 4 {
            addClosedBar(o1h, h1h, l1h, c1h, v1h, bucket1hOpen, bucket1hHigh, bucket1hLow, close, bucket1hVolume)
            snap1h := makeSnapshot(o1h, h1h, l1h, c1h, v1h)
        }
        count1h := 0
    }
}

// Native 15m Ichimoku is calculated by talib, avoiding per-bar custom loops.
float tenkan15 = (talib.highest(high, TENKAN) + talib.lowest(low, TENKAN)) / 2.0
float kijun15 = (talib.highest(high, KIJUN) + talib.lowest(low, KIJUN)) / 2.0
float spanA15 = (tenkan15 + kijun15) / 2.0
float spanB15 = (talib.highest(high, SPAN_B) + talib.lowest(low, SPAN_B)) / 2.0
float currentA15 = spanA15[DISPLACEMENT - 1]
float currentB15 = spanB15[DISPLACEMENT - 1]
float top15 = math.max(currentA15, currentB15)
float bottom15 = math.min(currentA15, currentB15)
float atr15 = math.max(talib.atr(14), close * 0.0005)
float priorHigh15 = talib.highest(high[1], 20)
float priorLow15 = talib.lowest(low[1], 20)
float chikouPeak15 = talib.highest(close[1], KIJUN)
float chikouTrough15 = talib.lowest(close[1], KIJUN)
float volumeAverage15 = talib.sma(volume, 20)
float volumeRatio15 = volumeAverage15 > 0.0 ? volume / volumeAverage15 : 1.0
float range15 = math.max(high - low, 0.00000001)
float body15 = math.abs(close - open) / range15
float clv15 = math.min(1.0, math.max(0.0, (close - low) / range15))
float upperWick15 = math.max(0.0, (high - math.max(open, close)) / range15)
float lowerWick15 = math.max(0.0, (math.min(open, close) - low) / range15)
bool chikouBull15 = close > talib.highest(high[DISPLACEMENT - 1], 7)
bool chikouBear15 = close < talib.lowest(low[DISPLACEMENT - 1], 7)

float top30 = math.max(snap30.currentA, snap30.currentB)
float bottom30 = math.min(snap30.currentA, snap30.currentB)
float top1h = math.max(snap1h.currentA, snap1h.currentB)
float bottom1h = math.min(snap1h.currentA, snap1h.currentB)
bool dataReady = closed15m and snap30.ready and snap1h.ready and not na(currentA15) and not na(currentB15)

bool bullishBias = snap1h.c > top1h and snap30.c > top30 and close > top15
bool bearishBias = snap1h.c < bottom1h and snap30.c < bottom30 and close < bottom15
bool isLong = bullishBias and not bearishBias ? true : bearishBias and not bullishBias ? false : snap30.tenkan >= snap30.kijun

bool c1 = isLong ? bullishBias : bearishBias
bool c2 = isLong ? (snap1h.tenkan >= snap1h.kijun and snap30.tenkan >= snap30.kijun and tenkan15 >= kijun15) : (snap1h.tenkan <= snap1h.kijun and snap30.tenkan <= snap30.kijun and tenkan15 <= kijun15)
bool c3 = isLong ? (snap1h.tenkan >= snap1h.prevTenkan - snap1h.atr * 0.05 and snap30.tenkan >= snap30.prevTenkan - snap30.atr * 0.05 and tenkan15 >= tenkan15[1] - atr15 * 0.05) : (snap1h.tenkan <= snap1h.prevTenkan + snap1h.atr * 0.05 and snap30.tenkan <= snap30.prevTenkan + snap30.atr * 0.05 and tenkan15 <= tenkan15[1] + atr15 * 0.05)
bool c4 = isLong ? (snap1h.futureA > snap1h.futureB and snap1h.futureA >= snap1h.prevFutureA and snap30.futureA > snap30.futureB and snap30.futureA >= snap30.prevFutureA) : (snap1h.futureA < snap1h.futureB and snap1h.futureA <= snap1h.prevFutureA and snap30.futureA < snap30.futureB and snap30.futureA <= snap30.prevFutureA)
bool c5 = math.abs(snap1h.futureA - snap1h.futureB) / math.max(snap1h.atr, 0.00000001) >= 0.05 and math.abs(snap30.futureA - snap30.futureB) / math.max(snap30.atr, 0.00000001) >= 0.04
bool c6 = isLong ? (snap1h.chikouBull and snap30.chikouBull and chikouBull15) : (snap1h.chikouBear and snap30.chikouBear and chikouBear15)
bool c7 = isLong ? close >= chikouPeak15 - atr15 * 0.15 : close <= chikouTrough15 + atr15 * 0.15
bool c8 = math.abs(close - kijun15) / atr15 <= maxKijunExtensionAtr and math.abs(snap30.c - snap30.kijun) / math.max(snap30.atr, 0.00000001) <= maxKijunExtensionAtr and not (snap30.kijunFlat and snap30.ssbFlat)
bool c9 = isLong ? close >= top15 + (snap30.ssbFlat ? atr15 * 0.15 : 0.0) : close <= bottom15 - (snap30.ssbFlat ? atr15 * 0.15 : 0.0)
bool c10 = not (snap1h.kijunFlat and snap1h.ssbFlat and snap30.kijunFlat and snap30.ssbFlat)
bool directionalCandle = isLong ? (close > open and clv15 >= 0.45 and body15 >= 0.22) : (close < open and clv15 <= 0.55 and body15 >= 0.22)
bool c11 = directionalCandle and volumeRatio15 >= 0.60
bool c13 = (snap1h.er >= 0.20 or snap30.er >= 0.22) and not (snap1h.kijunFlat and snap30.kijunFlat)
bool c14 = isLong ? (upperWick15 <= 0.45 and (body15 >= 0.22 or lowerWick15 >= 0.25)) : (lowerWick15 <= 0.45 and (body15 >= 0.22 or upperWick15 >= 0.25))
bool c15 = c13 and c8 and (isLong ? tenkan15 >= kijun15 : tenkan15 <= kijun15)

bool triggerKatana = isLong ? (talib.crossover(tenkan15, kijun15) and close > top15 and close > open) : (talib.crossunder(tenkan15, kijun15) and close < bottom15 and close < open)
bool triggerPullback = isLong ? (low <= math.max(tenkan15, kijun15) + atr15 * 0.25 and close > tenkan15 and close > top15 and close > open) : (high >= math.min(tenkan15, kijun15) - atr15 * 0.25 and close < tenkan15 and close < bottom15 and close < open)
bool triggerBreakout = isLong ? (close > priorHigh15 and close > top15 + atr15 * 0.10 and close >= chikouPeak15 and close > open) : (close < priorLow15 and close < bottom15 - atr15 * 0.10 and close <= chikouTrough15 and close < open)
bool triggerFired = triggerKatana or triggerPullback or triggerBreakout

float entryAnchor = close
float stopFloor = math.max(close * 0.0025, atr15 * 0.80)
float stopCeiling = math.max(stopFloor, atr15 * 2.10)
float rawStop = isLong ? math.min(kijun15, snap30.kijun) - atr15 * slBufferAtr : math.max(kijun15, snap30.kijun) + atr15 * slBufferAtr
float rawStopDistance = math.abs(entryAnchor - rawStop)
float stopDistance = math.min(math.max(rawStopDistance, stopFloor), stopCeiling)
float targetDistance = stopDistance * 2.25
float stopPrice = isLong ? entryAnchor - stopDistance : entryAnchor + stopDistance
float targetPrice = isLong ? entryAnchor + targetDistance : entryAnchor - targetDistance
float rr = targetDistance / math.max(stopDistance, 0.00000001)
bool c12 = rr >= 1.5 and rr <= 3.0 and targetDistance >= entryAnchor * roundTripCostPct * 2.0
bool c16 = math.abs(close - tenkan15) / atr15 <= 0.85
float costToRisk = entryAnchor * roundTripCostPct / math.max(stopDistance, 0.00000001)
bool c17 = costToRisk <= 0.45

float regimeScore = (c1 ? 1.0 : 0.0) + (c3 ? 1.0 : 0.0) + (c4 ? 1.0 : 0.0) + (c6 ? 1.0 : 0.0) + (c17 ? 1.2 : 0.0)
float qualityScore = (c5 ? 0.6 : 0.0) + (c8 ? 1.0 : 0.0) + (c9 ? 1.0 : 0.0) + (c13 ? 1.0 : 0.0) + (c14 ? 0.6 : 0.0) + (c15 ? 1.0 : 0.0)
float triggerScore = (c2 ? 0.6 : 0.0) + (c7 ? 0.6 : 0.0) + (c10 ? 0.8 : 0.0) + (c11 ? 1.2 : 0.0) + (c12 ? 1.0 : 0.0) + (c16 ? 1.2 : 0.0) + (c17 ? 1.2 : 0.0)
float bookPct = (regimeScore + qualityScore + triggerScore) / 17.0 * 100.0
float qualityPct = qualityScore / 5.2 * 100.0
float triggerPct = triggerScore / 6.6 * 100.0
bool hardVetoPassed = c1 and c3 and c4 and c6 and c17
bool bookFires = hardVetoPassed and qualityPct >= 60.0 and triggerPct >= 60.0 and bookPct >= 70.0
int passedCount = (c1 ? 1 : 0) + (c2 ? 1 : 0) + (c3 ? 1 : 0) + (c4 ? 1 : 0) + (c5 ? 1 : 0) + (c6 ? 1 : 0) + (c7 ? 1 : 0) + (c8 ? 1 : 0) + (c9 ? 1 : 0) + (c10 ? 1 : 0) + (c11 ? 1 : 0) + (c12 ? 1 : 0) + (c13 ? 1 : 0) + (c14 ? 1 : 0) + (c15 ? 1 : 0) + (c16 ? 1 : 0) + (c17 ? 1 : 0)

bool strictSignal = dataReady and triggerFired and bookFires
bool rawTrigger = dataReady and triggerFired and not strictSignal
bool debugSignal = debugVirtualTriggerTrades and rawTrigger
bool entryDecision = strictSignal or debugSignal

// One lifecycle lock covers both the next-open pending order and the open
// position. It blocks repeated Long/Short orders until that trade has ended.
int MAX_RETAINED_BRACKETS = 150
static int tradeLockState = 0 // 0=idle, 1=submitted/pending, 2=open
static int lockedSignalBar = na
static int pendingSide = 0
static float pendingStopPrice = na
static float pendingTargetPrice = na
static line activeEntryLine = na
static line activeStopLine = na
static line activeTargetLine = na
static label activeBracketLabel = na
static float activeEntryPrice = na
static float activeStopPrice = na
static float activeTargetPrice = na
static bool bracketIsLive = false
static int observedClosedTrades = 0
static array<line> bracketHistory = array.new<line>(0)
static array<label> bracketLabelHistory = array.new<label>(0)

// A closed-trade count also catches a fill and exit within one historical bar.
bool tradeClosedThisBar = strategy.closedtrades > observedClosedTrades
bool justOpened = strategy.position_size != 0 and strategy.position_size[1] == 0
bool filledAndClosedThisBar = tradeLockState == 1 and strategy.position_size == 0 and tradeClosedThisBar
bool canOpenSingleTrade = tradeLockState == 0 and strategy.position_size == 0
bool blockedByOpenTrade = entryDecision and not canOpenSingleTrade
bool enterLong = entryDecision and canOpenSingleTrade and isLong and allowLong
bool enterShort = entryDecision and canOpenSingleTrade and not isLong and allowShort

// Submit a next-open market entry and freeze the exact bracket prices. The
// prices are sent to strategy.exit only after GoCharting reports an open fill.
if enterLong {
    tradeLockState := 1
    lockedSignalBar := bar_index
    pendingSide := 1
    pendingStopPrice := stopPrice
    pendingTargetPrice := targetPrice
    strategy.entry("Lite Long", strategy.long, qty=qty, comment=debugSignal ? "DEBUG raw trigger long" : "BASE Lite long")
}
if enterShort {
    tradeLockState := 1
    lockedSignalBar := bar_index
    pendingSide := -1
    pendingStopPrice := stopPrice
    pendingTargetPrice := targetPrice
    strategy.entry("Lite Short", strategy.short, qty=qty, comment=debugSignal ? "DEBUG raw trigger short" : "BASE Lite short")
}

// Place and keep the exact frozen bracket live after a fill; no price is
// recomputed from subsequent candles.
if strategy.position_size > 0 and tradeLockState != 0 {
    strategy.exit("Lite Long exit", from_entry="Lite Long", stop=pendingStopPrice, limit=pendingTargetPrice)
}
if strategy.position_size < 0 and tradeLockState != 0 {
    strategy.exit("Lite Short exit", from_entry="Lite Short", stop=pendingStopPrice, limit=pendingTargetPrice)
}

// Draw only after an order actually fills. The marker therefore never marks a
// rejected/repeated signal. The entry price is the broker-emulator fill price;
// SL/TP are exactly the frozen stop/limit prices above.
bool actualLongEntry = justOpened and strategy.position_size > 0
bool actualShortEntry = justOpened and strategy.position_size < 0
bool actualLongFillAndExit = filledAndClosedThisBar and pendingSide == 1
bool actualShortFillAndExit = filledAndClosedThisBar and pendingSide == -1
if justOpened {
    tradeLockState := 2
    activeEntryPrice := strategy.position_avg_price
    activeStopPrice := pendingStopPrice
    activeTargetPrice := pendingTargetPrice
    activeEntryLine := line.new(lockedSignalBar + 1, activeEntryPrice, bar_index, activeEntryPrice, extend=extend.none, color=color.silver, style=line.style_dotted, width=1)
    activeStopLine := line.new(lockedSignalBar + 1, activeStopPrice, bar_index, activeStopPrice, extend=extend.none, color=color.red, style=line.style_solid, width=2)
    activeTargetLine := line.new(lockedSignalBar + 1, activeTargetPrice, bar_index, activeTargetPrice, extend=extend.none, color=color.lime, style=line.style_solid, width=2)
    string bracketText = (strategy.position_size > 0 ? "LONG" : "SHORT") + "\nEntry " + str.tostring(activeEntryPrice, "#.##") + "\nSL " + str.tostring(activeStopPrice, "#.##") + "\nTP " + str.tostring(activeTargetPrice, "#.##")
    if strategy.position_size > 0 {
        activeBracketLabel := label.new(bar_index, low, bracketText, yloc=yloc.belowbar, style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)
    } else {
        activeBracketLabel := label.new(bar_index, high, bracketText, yloc=yloc.abovebar, style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)
    }
    bracketIsLive := true
}

// On a gap/large bar the entry can fill and exit before the next script pass.
// Build the same historical bracket from the completed trade in that case.
if filledAndClosedThisBar {
    activeEntryPrice := strategy.closedtrades_entry_price(strategy.closedtrades - 1)
    activeStopPrice := pendingStopPrice
    activeTargetPrice := pendingTargetPrice
    activeEntryLine := line.new(lockedSignalBar + 1, activeEntryPrice, bar_index, activeEntryPrice, extend=extend.none, color=color.silver, style=line.style_dotted, width=1)
    activeStopLine := line.new(lockedSignalBar + 1, activeStopPrice, bar_index, activeStopPrice, extend=extend.none, color=color.red, style=line.style_solid, width=2)
    activeTargetLine := line.new(lockedSignalBar + 1, activeTargetPrice, bar_index, activeTargetPrice, extend=extend.none, color=color.lime, style=line.style_solid, width=2)
    string sameBarText = (pendingSide == 1 ? "LONG" : "SHORT") + "\nEntry " + str.tostring(activeEntryPrice, "#.##") + "\nSL " + str.tostring(activeStopPrice, "#.##") + "\nTP " + str.tostring(activeTargetPrice, "#.##")
    if pendingSide == 1 {
        activeBracketLabel := label.new(lockedSignalBar + 1, low, sameBarText, yloc=yloc.belowbar, style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)
    } else {
        activeBracketLabel := label.new(lockedSignalBar + 1, high, sameBarText, yloc=yloc.abovebar, style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)
    }
    bracketIsLive := true
}

if strategy.position_size != 0 and bracketIsLive and not justOpened {
    line.set_xy2(activeEntryLine, bar_index, activeEntryPrice)
    line.set_xy2(activeStopLine, bar_index, activeStopPrice)
    line.set_xy2(activeTargetLine, bar_index, activeTargetPrice)
}

// Finalise and retain completed brackets. Capping objects keeps the strategy
// below GoCharting's drawing limits while preserving the latest 150 trades.
if tradeClosedThisBar and bracketIsLive {
    line.set_xy2(activeEntryLine, bar_index, activeEntryPrice)
    line.set_xy2(activeStopLine, bar_index, activeStopPrice)
    line.set_xy2(activeTargetLine, bar_index, activeTargetPrice)
    array.push(bracketHistory, activeEntryLine)
    array.push(bracketHistory, activeStopLine)
    array.push(bracketHistory, activeTargetLine)
    array.push(bracketLabelHistory, activeBracketLabel)
    if array.length(bracketHistory) > MAX_RETAINED_BRACKETS * 3 {
        line.delete(array.shift(bracketHistory))
        line.delete(array.shift(bracketHistory))
        line.delete(array.shift(bracketHistory))
    }
    if array.length(bracketLabelHistory) > MAX_RETAINED_BRACKETS {
        label.delete(array.shift(bracketLabelHistory))
    }
    bracketIsLive := false
    activeEntryPrice := na
    activeStopPrice := na
    activeTargetPrice := na
    tradeLockState := 0
    lockedSignalBar := na
    pendingSide := 0
    pendingStopPrice := na
    pendingTargetPrice := na
}

// An unfilled market order can only remain pending at the last unavailable
// next-open. Keep it locked until a fill/close is observable; never submit a
// second direction while the lifecycle is unresolved.
if strategy.closedtrades > observedClosedTrades {
    observedClosedTrades := strategy.closedtrades
}

if strategy.position_size > 0 and strategy.opentrades > 0 and bar_index - strategy.opentrades_entry_bar_index(0) >= maxHoldBars {
    strategy.close("Lite Long", comment="time stop")
}
if strategy.position_size < 0 and strategy.opentrades > 0 and bar_index - strategy.opentrades_entry_bar_index(0) >= maxHoldBars {
    strategy.close("Lite Short", comment="time stop")
}

// Three readable guides only: native 15m, built 30m, built 1H.
plot(kijun15, title="15m Kijun", color=color.orange, linewidth=2)
plot(snap30.kijun, title="Built 30m Kijun", color=color.teal, linewidth=2, style=plotStyle.stepLine)
plot(snap1h.kijun, title="Built 1H Kijun", color=color.purple, linewidth=2, style=plotStyle.stepLine)
plotshape(actualLongEntry, title="Accepted Lite long entry", location=location.belowbar, shape=shape.triangleup, color=color.lime, size=size.normal, text="LITE L")
plotshape(actualShortEntry, title="Accepted Lite short entry", location=location.abovebar, shape=shape.triangledown, color=color.red, size=size.normal, text="LITE S")
plotshape(actualLongFillAndExit, title="Accepted Lite long fill and exit", location=location.belowbar, shape=shape.triangleup, color=color.lime, size=size.normal, text="LITE L")
plotshape(actualShortFillAndExit, title="Accepted Lite short fill and exit", location=location.abovebar, shape=shape.triangledown, color=color.red, size=size.normal, text="LITE S")
plotshape(showRawTriggers and rawTrigger and isLong, title="Raw long trigger", location=location.belowbar, shape=shape.diamond, color=color.aqua, size=size.tiny, text="RAW")
plotshape(showRawTriggers and rawTrigger and not isLong, title="Raw short trigger", location=location.abovebar, shape=shape.diamond, color=color.aqua, size=size.tiny, text="RAW")
plotshape(showRawTriggers and blockedByOpenTrade, title="Signal ignored while trade locked", location=location.top, shape=shape.xcross, color=color.yellow, size=size.tiny, text="LOCK")

static table dashboard = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 0.25), border_width=1)
if barstate.islast {
    table.cell(dashboard, 0, 0, "BASE LITE 15/30/1H")
    table.cell(dashboard, 1, 0, chartIs15m ? "15m OK" : "CHANGE TO 15m", textcolor=chartIs15m ? color.lime : color.red)
    table.cell(dashboard, 0, 1, "Closed HTF bars")
    table.cell(dashboard, 1, 1, "30m " + str.tostring(array.length(c30)) + " | 1H " + str.tostring(array.length(c1h)))
    table.cell(dashboard, 0, 2, "Data")
    table.cell(dashboard, 1, 2, dataReady ? "READY" : "WARM-UP: need 57 H1", textcolor=dataReady ? color.lime : color.orange)
    table.cell(dashboard, 0, 3, "Bias")
    table.cell(dashboard, 1, 3, dataReady ? (isLong ? "LONG" : "SHORT") : "-")
    table.cell(dashboard, 0, 4, "Trigger")
    table.cell(dashboard, 1, 4, triggerKatana ? "KATANA" : triggerPullback ? "PULLBACK" : triggerBreakout ? "BREAKOUT" : "-", textcolor=triggerFired ? color.aqua : color.gray)
    table.cell(dashboard, 0, 5, "Conditions")
    table.cell(dashboard, 1, 5, str.tostring(passedCount) + " / 17")
    table.cell(dashboard, 0, 6, "Book gate")
    table.cell(dashboard, 1, 6, str.tostring(bookPct, "#.0") + "%", textcolor=bookFires ? color.lime : color.orange)
    table.cell(dashboard, 0, 7, "Status")
    table.cell(dashboard, 1, 7, tradeLockState != 0 ? "LOCKED: ONE TRADE" : strictSignal ? "STRICT SIGNAL" : debugSignal ? "DEBUG ENTRY" : rawTrigger ? "RAW BLOCKED" : hardVetoPassed ? "WAITING" : "HARD VETO", textcolor=tradeLockState != 0 ? color.yellow : strictSignal ? color.lime : debugSignal ? color.aqua : rawTrigger ? color.orange : hardVetoPassed ? color.yellow : color.red)
}
