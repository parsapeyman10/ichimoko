//@lipi=2
// BASE_ICHIMOKU 4TF visual audit for a 15-minute GoCharting chart.
//
// This is a historical strategy only. GoCharting simulates orders; it never
// sends an order to Binance or another exchange.
//
// IMPORTANT: Lipi cannot request another timeframe. This script constructs
// closed 1H and 4H bars itself from the chart's confirmed 15m candles. It must
// therefore be attached only to a standard 15-minute chart in UTC.
//
// Reference path: BitcoinStrategyModel.BASE_ICHIMOKU at f1c9850.
// Pure base only: no Hidden Cross, Parsa, BTC-52, Peyman or NeoWave path.
// 0.105% each side approximates the reference 10 bp fee/side plus 1 bp
// round-trip spread. It is a backtest cost convention, not live routing.
strategy("BASE ICHIMOKU 4TF audit (15m-built 1H/4H)", overlay=true, initial_capital=1000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission_percent, commission_value=0.105, pyramiding=0, process_orders_on_close=false, max_labels_count=500)

int TENKAN = input.int(9, "Tenkan", minval=2)
int KIJUN = input.int(26, "Kijun", minval=2)
int SPAN_B = input.int(52, "Senkou B", minval=2)
int DISPLACEMENT = input.int(26, "Displacement", minval=2)
float qty = input.float(1.0, "Backtest quantity", minval=0.000001, step=0.01)
bool allowLong = input.bool(true, "Enable long")
bool allowShort = input.bool(true, "Enable short")
bool showNearMiss = input.bool(true, "Show trigger / gate rejects")
float maxKijunExtensionAtr = input.float(1.80, "Max Kijun extension (ATR)", minval=0.50, step=0.05)
float slBufferAtr = input.float(0.25, "Structural SL buffer (ATR)", minval=0.15, step=0.01)
float minVolumeRatio = input.float(0.60, "Min volume / 20", minval=0.10, step=0.05)
float minEr = input.float(0.20, "Min ER14", minval=0.05, step=0.01)
float maxAdverseWick = input.float(0.45, "Max adverse wick", minval=0.10, step=0.05)
float roundTripCostPct = input.float(0.0021, "Round-trip execution cost fraction", minval=0.0, step=0.0001)
int maxHoldBars = input.int(20, "Time stop: 15m bars", minval=1)

// The reusable snapshot has exactly the fields consumed by the pure BASE
// conditions. Every price/ratio is rounded to two decimals like the Android
// snapshot before conditions read it.
type TfSnap {
    bool ready
    float o
    float h
    float l
    float c
    float tenkan
    float kijun
    float prevTenkan
    float prevKijun
    float currentA
    float currentB
    float futureA
    float futureB
    float prevFutureA
    float prevFutureB
    float atr
    bool chikouBull
    bool chikouBear
    float chikouPeak
    float chikouTrough
    bool ssbFlat
    bool kijunFlat
    bool tenkanFlat
    float body
    float clv
    float volumeRatio
    float kijunSlope
    float tenkanSlope
    float futureThickness
    bool cClamp
    bool bullImpulse
    bool bearImpulse
    float er
    float upperWick
    float lowerWick
    bool katanaRelease
    float downFractal
    float upFractal
    float kijun30
    float ema34
}

type HosodaWave {
    bool valid
    bool sHeld
    float a
    float b
    float c
    float targetV
    float targetN
    float targetE
    float targetNT
    int barsSinceA
    bool nearCycle
}

func r2(float value) => math.round(value, 2)

func arrMax(array<float> values, int first, int last) {
    float best = array.get(values, first)
    if last > first {
        for i = first + 1 to last {
            best := math.max(best, array.get(values, i))
        }
    }
    return best
}

func arrMin(array<float> values, int first, int last) {
    float best = array.get(values, first)
    if last > first {
        for i = first + 1 to last {
            best := math.min(best, array.get(values, i))
        }
    }
    return best
}

func arrMid(array<float> highs, array<float> lows, int endIndex, int period) {
    int safeEnd = math.max(0, endIndex)
    int first = math.max(0, safeEnd - period + 1)
    return (arrMax(highs, first, safeEnd) + arrMin(lows, first, safeEnd)) / 2.0
}

func spanACreated(array<float> highs, array<float> lows, int index) {
    float t = arrMid(highs, lows, index, TENKAN)
    float k = arrMid(highs, lows, index, KIJUN)
    return (t + k) / 2.0
}

func spanBCreated(array<float> highs, array<float> lows, int index) => arrMid(highs, lows, index, SPAN_B)

func currentAAt(array<float> highs, array<float> lows, int index) => spanACreated(highs, lows, math.max(0, index - (DISPLACEMENT - 1)))
func currentBAt(array<float> highs, array<float> lows, int index) => spanBCreated(highs, lows, math.max(0, index - (DISPLACEMENT - 1)))

func trAt(array<float> highs, array<float> lows, array<float> closes, int index) {
    float h = array.get(highs, index)
    float l = array.get(lows, index)
    float previousClose = array.get(closes, math.max(0, index - 1))
    return math.max(h - l, math.max(math.abs(h - previousClose), math.abs(l - previousClose)))
}

func atrAt(array<float> highs, array<float> lows, array<float> closes, int index) {
    int first = math.max(0, index - 13)
    float total = trAt(highs, lows, closes, first)
    if index > first {
        for i = first + 1 to index {
            total += trAt(highs, lows, closes, i)
        }
    }
    float average = total / (index - first + 1)
    return math.max(average, array.get(closes, index) * 0.0005)
}

func emaAt(array<float> closes, int endIndex, int period) {
    float alpha = 2.0 / (period + 1.0)
    float value = array.get(closes, 0)
    if endIndex > 0 {
        for i = 1 to endIndex {
            value := array.get(closes, i) * alpha + value * (1.0 - alpha)
        }
    }
    return value
}

func addBar(array<float> opens, array<float> highs, array<float> lows, array<float> closes, array<float> volumes, float o, float h, float l, float c, float v) {
    array.push(opens, o)
    array.push(highs, h)
    array.push(lows, l)
    array.push(closes, c)
    array.push(volumes, v)
    // The source snapshots retain the last 200 bars for this pure-base path.
    if array.length(closes) > 200 {
        array.shift(opens)
        array.shift(highs)
        array.shift(lows)
        array.shift(closes)
        array.shift(volumes)
    }
}

func buildSnapshot(array<float> opens, array<float> highs, array<float> lows, array<float> closes, array<float> volumes) {
    int n = array.length(closes)
    if n < SPAN_B + 5 {
        return TfSnap.new(ready=false)
    }

    int last = n - 1
    int prev = math.max(0, last - 1)
    float o = array.get(opens, last)
    float h = array.get(highs, last)
    float l = array.get(lows, last)
    float c = array.get(closes, last)
    float tenkan = arrMid(highs, lows, last, TENKAN)
    float kijun = arrMid(highs, lows, last, KIJUN)
    float prevTenkan = arrMid(highs, lows, prev, TENKAN)
    float prevKijun = arrMid(highs, lows, prev, KIJUN)
    float curA = currentAAt(highs, lows, last)
    float curB = currentBAt(highs, lows, last)
    float futureA = spanACreated(highs, lows, last)
    float futureB = spanBCreated(highs, lows, last)
    float prevFutureA = spanACreated(highs, lows, prev)
    float prevFutureB = spanBCreated(highs, lows, prev)
    float atr = atrAt(highs, lows, closes, last)

    int chikouIndex = math.max(0, last - (DISPLACEMENT - 1))
    int corridorEnd = math.min(last, chikouIndex + 6)
    float kHigh = array.get(highs, chikouIndex)
    float kLow = array.get(lows, chikouIndex)
    float kCloudTop = math.max(currentAAt(highs, lows, chikouIndex), currentBAt(highs, lows, chikouIndex))
    float kCloudBottom = math.min(currentAAt(highs, lows, chikouIndex), currentBAt(highs, lows, chikouIndex))
    float kTkTop = math.max(arrMid(highs, lows, chikouIndex, TENKAN), arrMid(highs, lows, chikouIndex, KIJUN))
    float kTkBottom = math.min(arrMid(highs, lows, chikouIndex, TENKAN), arrMid(highs, lows, chikouIndex, KIJUN))
    bool chikouBull = c > math.max(kHigh, math.max(kCloudTop, kTkTop))
    bool chikouBear = c < math.min(kLow, math.min(kCloudBottom, kTkBottom))
    if corridorEnd > chikouIndex {
        for i = chikouIndex + 1 to corridorEnd {
            float hi = array.get(highs, i)
            float lo = array.get(lows, i)
            float cloudTop = math.max(currentAAt(highs, lows, i), currentBAt(highs, lows, i))
            float cloudBottom = math.min(currentAAt(highs, lows, i), currentBAt(highs, lows, i))
            float tkTop = math.max(arrMid(highs, lows, i, TENKAN), arrMid(highs, lows, i, KIJUN))
            float tkBottom = math.min(arrMid(highs, lows, i, TENKAN), arrMid(highs, lows, i, KIJUN))
            chikouBull := chikouBull and c > math.max(hi, math.max(cloudTop, tkTop))
            chikouBear := chikouBear and c < math.min(lo, math.min(cloudBottom, tkBottom))
        }
    }

    int chikouStart = math.max(1, last - KIJUN)
    float chikouPeak = array.get(closes, chikouStart)
    float chikouTrough = array.get(closes, chikouStart)
    if last - 1 > chikouStart {
        for i = chikouStart + 1 to last - 1 {
            float x = array.get(closes, i)
            chikouPeak := math.max(chikouPeak, x)
            chikouTrough := math.min(chikouTrough, x)
        }
    }

    float flatTolerance = math.max(c * 0.0003, atr * 0.04)
    float spanB2 = currentBAt(highs, lows, math.max(0, last - 2))
    bool ssbFlat = math.abs(curB - currentBAt(highs, lows, prev)) <= flatTolerance and math.abs(curB - spanB2) <= flatTolerance
    bool kijunFlat = math.abs(kijun - prevKijun) <= flatTolerance
    bool tenkanFlat = math.abs(tenkan - prevTenkan) <= flatTolerance

    float candleRange = math.max(h - l, 0.00000001)
    float body = math.abs(c - o) / candleRange
    float clv = math.min(1.0, math.max(0.0, (c - l) / candleRange))
    int volumeStart = math.max(0, last - 19)
    float volumeSum = array.get(volumes, volumeStart)
    if last > volumeStart {
        for i = volumeStart + 1 to last {
            volumeSum += array.get(volumes, i)
        }
    }
    float averageVolume = volumeSum / (last - volumeStart + 1)
    float volumeRatio = averageVolume > 0.0 and array.get(volumes, last) > 0.0 ? array.get(volumes, last) / averageVolume : 1.0

    float kijunSlope = (kijun - arrMid(highs, lows, math.max(0, last - 3), KIJUN)) / (3.0 * atr)
    float tenkanSlope = (tenkan - prevTenkan) / atr
    float futureThickness = math.abs(futureA - futureB) / atr
    float distanceKijun = math.abs(c - kijun) / atr
    bool cClamp = kijunFlat and ssbFlat and distanceKijun > maxKijunExtensionAtr * 1.05
    float upperWick = math.max(0.0, (h - math.max(o, c)) / candleRange)
    float lowerWick = math.max(0.0, (math.min(o, c) - l) / candleRange)

    float previous1Close = array.get(closes, math.max(0, last - 1))
    float previous2Close = array.get(closes, math.max(0, last - 2))
    float previous1Open = array.get(opens, math.max(0, last - 1))
    float previous2Open = array.get(opens, math.max(0, last - 2))
    int bullishBars = (c > o ? 1 : 0) + (previous1Close > previous1Open ? 1 : 0) + (previous2Close > previous2Open ? 1 : 0)
    int bearishBars = (c < o ? 1 : 0) + (previous1Close < previous1Open ? 1 : 0) + (previous2Close < previous2Open ? 1 : 0)
    bool bullImpulse = bullishBars >= 2 and c >= math.max(previous1Close, previous2Close)
    bool bearImpulse = bearishBars >= 2 and c <= math.min(previous1Close, previous2Close)

    int erStart = math.max(0, last - 14)
    float erPath = 0.0
    if last > erStart {
        for i = erStart + 1 to last {
            erPath += math.abs(array.get(closes, i) - array.get(closes, i - 1))
        }
    }
    float er = erPath > 0.00000001 ? math.min(1.0, math.max(0.0, math.abs(c - array.get(closes, erStart)) / erPath)) : 0.5

    bool compressedRecently = math.abs(prevTenkan - prevKijun) <= atr * 0.18 or math.abs(arrMid(highs, lows, math.max(0, last - 2), TENKAN) - arrMid(highs, lows, math.max(0, last - 2), KIJUN)) <= atr * 0.18 or math.abs(arrMid(highs, lows, math.max(0, last - 3), TENKAN) - arrMid(highs, lows, math.max(0, last - 3), KIJUN)) <= atr * 0.18
    bool katanaRelease = compressedRecently and math.abs(tenkan - kijun) >= math.abs(prevTenkan - prevKijun) and body >= 0.32

    int fractalStart = math.max(0, last - 8)
    float downFractal = arrMin(lows, fractalStart, last)
    float upFractal = arrMax(highs, fractalStart, last)
    int fractalLower = math.max(2, last - 28)
    if last - 2 > fractalLower {
        for i = last - 2 to fractalLower {
            float fLow = array.get(lows, i)
            if fLow <= array.get(lows, i - 1) and fLow <= array.get(lows, i - 2) and fLow <= array.get(lows, i + 1) and fLow <= array.get(lows, i + 2) {
                downFractal := fLow
                break
            }
        }
        for i = last - 2 to fractalLower {
            float fHigh = array.get(highs, i)
            if fHigh >= array.get(highs, i - 1) and fHigh >= array.get(highs, i - 2) and fHigh >= array.get(highs, i + 1) and fHigh >= array.get(highs, i + 2) {
                upFractal := fHigh
                break
            }
        }
    }

    return TfSnap.new(ready=true, o=r2(o), h=r2(h), l=r2(l), c=r2(c), tenkan=r2(tenkan), kijun=r2(kijun), prevTenkan=r2(prevTenkan), prevKijun=r2(prevKijun), currentA=r2(curA), currentB=r2(curB), futureA=r2(futureA), futureB=r2(futureB), prevFutureA=r2(prevFutureA), prevFutureB=r2(prevFutureB), atr=r2(atr), chikouBull=chikouBull, chikouBear=chikouBear, chikouPeak=r2(chikouPeak), chikouTrough=r2(chikouTrough), ssbFlat=ssbFlat, kijunFlat=kijunFlat, tenkanFlat=tenkanFlat, body=r2(body), clv=r2(clv), volumeRatio=r2(volumeRatio), kijunSlope=r2(kijunSlope), tenkanSlope=r2(tenkanSlope), futureThickness=r2(futureThickness), cClamp=cClamp, bullImpulse=bullImpulse, bearImpulse=bearImpulse, er=r2(er), upperWick=r2(upperWick), lowerWick=r2(lowerWick), katanaRelease=katanaRelease, downFractal=r2(downFractal), upFractal=r2(upFractal), kijun30=r2(arrMid(highs, lows, last, 30)), ema34=r2(emaAt(closes, last, 34)))
}

func buildWave(array<float> highs, array<float> lows, TfSnap snap, bool isLong) {
    int n = array.length(highs)
    if n < 12 {
        return HosodaWave.new(valid=false)
    }
    int last = n - 1
    // The reference extracts the last 65 strategy bars before Hosoda scanning.
    int firstAllowed = math.max(0, n - 65)
    int cStart = math.max(firstAllowed + 4, last - 6)
    int cIndex = cStart
    if last > cStart {
        for i = cStart + 1 to last {
            bool betterC = isLong ? array.get(lows, i) <= array.get(lows, cIndex) : array.get(highs, i) >= array.get(highs, cIndex)
            if betterC {
                cIndex := i
            }
        }
    }
    int bStart = math.max(firstAllowed + 2, cIndex - 22)
    int bIndex = bStart
    if cIndex - 1 > bStart {
        for i = bStart + 1 to cIndex - 1 {
            bool betterB = isLong ? array.get(highs, i) >= array.get(highs, bIndex) : array.get(lows, i) <= array.get(lows, bIndex)
            if betterB {
                bIndex := i
            }
        }
    }
    int aStart = math.max(firstAllowed, bIndex - 45)
    int aIndex = aStart
    if bIndex > aStart {
        for i = aStart + 1 to bIndex {
            bool betterA = isLong ? array.get(lows, i) <= array.get(lows, aIndex) : array.get(highs, i) >= array.get(highs, aIndex)
            if betterA {
                aIndex := i
            }
        }
    }

    float pointA = 0.0
    float pointB = 0.0
    float pointC = 0.0
    float targetV = 0.0
    float targetN = 0.0
    float targetE = 0.0
    float targetNT = 0.0
    bool sHeld = false
    if isLong {
        float rawA = array.get(lows, aIndex)
        float rawB = math.max(array.get(highs, bIndex), snap.c)
        float rawC = math.min(array.get(lows, cIndex), snap.tenkan)
        float height = math.max(rawB - rawA, math.max(math.abs(snap.c - snap.kijun) * 2.4, snap.atr * 3.0))
        pointA := rawB - height
        pointB := rawB
        pointC := math.min(math.max(rawC, pointA + snap.atr * 0.3), pointB - snap.atr * 0.3)
        targetV := math.max(pointB + (pointB - pointC), snap.c + snap.atr * 1.5)
        targetN := math.max(pointC + (pointB - pointA), snap.c + snap.atr * 2.2)
        targetE := math.max(pointB + (pointB - pointA), snap.c + snap.atr * 3.0)
        targetNT := math.max(pointC + (pointC - pointA), snap.c + snap.atr * 1.2)
        sHeld := pointC >= math.min(snap.currentA, snap.currentB)
    } else {
        float rawA = array.get(highs, aIndex)
        float rawB = math.min(array.get(lows, bIndex), snap.c)
        float rawC = math.max(array.get(highs, cIndex), snap.tenkan)
        float height = math.max(rawA - rawB, math.max(math.abs(snap.c - snap.kijun) * 2.4, snap.atr * 3.0))
        pointA := rawB + height
        pointB := rawB
        pointC := math.min(math.max(rawC, pointB + snap.atr * 0.3), pointA - snap.atr * 0.3)
        targetV := math.max(0.00001, math.min(pointB - (pointC - pointB), snap.c - snap.atr * 1.5))
        targetN := math.max(0.00001, math.min(pointC - (pointA - pointB), snap.c - snap.atr * 2.2))
        targetE := math.max(0.00001, math.min(pointB - (pointA - pointB), snap.c - snap.atr * 3.0))
        targetNT := math.max(0.00001, math.min(pointC - (pointA - pointC), snap.c - snap.atr * 1.2))
        sHeld := pointC <= math.max(snap.currentA, snap.currentB)
    }
    int waveBars = last - aIndex + 1
    int nearestCycle = 9
    int nearestDistance = math.abs(waveBars - 9)
    int d17 = math.abs(waveBars - 17)
    int d26 = math.abs(waveBars - 26)
    int d33 = math.abs(waveBars - 33)
    int d42 = math.abs(waveBars - 42)
    int d65 = math.abs(waveBars - 65)
    if d17 < nearestDistance {
        nearestCycle := 17
        nearestDistance := d17
    }
    if d26 < nearestDistance {
        nearestCycle := 26
        nearestDistance := d26
    }
    if d33 < nearestDistance {
        nearestCycle := 33
        nearestDistance := d33
    }
    if d42 < nearestDistance {
        nearestCycle := 42
        nearestDistance := d42
    }
    if d65 < nearestDistance {
        nearestCycle := 65
        nearestDistance := d65
    }
    return HosodaWave.new(valid=true, sHeld=sHeld, a=r2(pointA), b=r2(pointB), c=r2(pointC), targetV=r2(targetV), targetN=r2(targetN), targetE=r2(targetE), targetNT=r2(targetNT), barsSinceA=waveBars, nearCycle=math.abs(nearestCycle - waveBars) <= 1)
}

// Raw flat Kijun/SSB levels. The Android source additionally merges nearby
// levels; for the gate, the nearest raw level is the conservative side of that
// merge and never invents extra room before a plateau.
// Build raw plateau levels only when a closed HTF bucket changes. This keeps
// full-history charts within Lipi's per-run budget while preserving the source
// decision rule (the Android merge of nearby levels is intentionally omitted).
func cacheFlatLevels(array<float> levels, array<float> highs, array<float> lows, array<float> closes, TfSnap snap) {
    array.clear(levels)
    int n = array.length(closes)
    if n >= 4 and snap.ready {
        int last = n - 1
        int first = math.max(3, last - 80)
        float tolerance = math.max(snap.c * 0.0003, snap.atr * 0.04)
        for i = first to last {
            float kj = arrMid(highs, lows, i, KIJUN)
            float kj1 = arrMid(highs, lows, i - 1, KIJUN)
            float kj2 = arrMid(highs, lows, i - 2, KIJUN)
            float ssb = currentBAt(highs, lows, i)
            float ssb1 = currentBAt(highs, lows, i - 1)
            float ssb2 = currentBAt(highs, lows, i - 2)
            if math.abs(kj - kj1) <= tolerance and math.abs(kj - kj2) <= tolerance {
                array.push(levels, kj)
            }
            if math.abs(ssb - ssb1) <= tolerance and math.abs(ssb - ssb2) <= tolerance {
                array.push(levels, ssb)
            }
        }
    }
}

func nearestCachedFlat(array<float> levels, bool isLong, float price, float atr) {
    float result = na
    for level in levels {
        bool ahead = isLong ? level > price + atr * 0.4 : level < price - atr * 0.4
        if ahead {
            result := na(result) ? level : (isLong ? math.min(result, level) : math.max(result, level))
        }
    }
    return result
}

func nearestFlatAhead(array<float> highs, array<float> lows, array<float> closes, TfSnap snap, bool isLong, float price) {
    int n = array.length(closes)
    int last = n - 1
    int first = math.max(3, last - 80)
    float result = na
    float tolerance = math.max(snap.c * 0.0003, snap.atr * 0.04)
    for i = first to last {
        float kj = arrMid(highs, lows, i, KIJUN)
        float kj1 = arrMid(highs, lows, i - 1, KIJUN)
        float kj2 = arrMid(highs, lows, i - 2, KIJUN)
        float ssb = currentBAt(highs, lows, i)
        float ssb1 = currentBAt(highs, lows, i - 1)
        float ssb2 = currentBAt(highs, lows, i - 2)
        bool flatKj = math.abs(kj - kj1) <= tolerance and math.abs(kj - kj2) <= tolerance
        bool flatSsb = math.abs(ssb - ssb1) <= tolerance and math.abs(ssb - ssb2) <= tolerance
        if flatKj {
            bool ahead = isLong ? kj > price + snap.atr * 0.4 : kj < price - snap.atr * 0.4
            if ahead {
                result := na(result) ? kj : (isLong ? math.min(result, kj) : math.max(result, kj))
            }
        }
        if flatSsb {
            bool ahead = isLong ? ssb > price + snap.atr * 0.4 : ssb < price - snap.atr * 0.4
            if ahead {
                result := na(result) ? ssb : (isLong ? math.min(result, ssb) : math.max(result, ssb))
            }
        }
    }
    return result
}

// 15m rolling source arrays and the two derived, fully closed timeframes.
static array<float> mO = array.new<float>(0)
static array<float> mH = array.new<float>(0)
static array<float> mL = array.new<float>(0)
static array<float> mC = array.new<float>(0)
static array<float> mV = array.new<float>(0)
static array<float> hO = array.new<float>(0)
static array<float> hH = array.new<float>(0)
static array<float> hL = array.new<float>(0)
static array<float> hC = array.new<float>(0)
static array<float> hV = array.new<float>(0)
static array<float> qO = array.new<float>(0)
static array<float> qH = array.new<float>(0)
static array<float> qL = array.new<float>(0)
static array<float> qC = array.new<float>(0)
static array<float> qV = array.new<float>(0)
// HTF arrays change only at a completed bucket. Persist their snapshots too,
// rather than rescan 200 bars on every intervening 15m candle.
static TfSnap h1Closed = TfSnap.new(ready=false)
static TfSnap h4Closed = TfSnap.new(ready=false)
static array<float> h1FlatLevels = array.new<float>(0)
static array<float> h4FlatLevels = array.new<float>(0)

static int hCount = 0
static float hOpen = na
static float hHigh = na
static float hLow = na
static float hVolume = 0.0
static int qCount = 0
static float qOpen = na
static float qHigh = na
static float qLow = na
static float qVolume = 0.0

bool chartIs15m = interval.isminutes and interval.multiplier == 15
bool confirmed15m = chartIs15m and barstate.isconfirmed

if confirmed15m {
    addBar(mO, mH, mL, mC, mV, open, high, low, close, volume)

    // Do not start in the middle of a bucket when GoCharting loaded only a
    // partial history. A 1H bar exists only after UTC xx:00/15/30/45 all ran.
    int utcMinute = minute(time, "UTC")
    int utcHour = hour(time, "UTC")
    if utcMinute == 0 {
        hOpen := open
        hHigh := high
        hLow := low
        hVolume := volume
        hCount := 1
    } else if hCount > 0 {
        hHigh := math.max(hHigh, high)
        hLow := math.min(hLow, low)
        hVolume += volume
        hCount += 1
    }
    if utcMinute == 45 {
        // A H1 bar is visible only after its final 15m candle has closed.
        if hCount == 4 {
            addBar(hO, hH, hL, hC, hV, hOpen, hHigh, hLow, close, hVolume)
            h1Closed := buildSnapshot(hO, hH, hL, hC, hV)
            cacheFlatLevels(h1FlatLevels, hH, hL, hC, h1Closed)
        }
        hCount := 0
    }

    // Same alignment rule for UTC 4H bars: 00:00 through 03:45, then 04:00.
    if utcMinute == 0 and utcHour % 4 == 0 {
        qOpen := open
        qHigh := high
        qLow := low
        qVolume := volume
        qCount := 1
    } else if qCount > 0 {
        qHigh := math.max(qHigh, high)
        qLow := math.min(qLow, low)
        qVolume += volume
        qCount += 1
    }
    if utcMinute == 45 and utcHour % 4 == 3 {
        // Same closed-only rule for the UTC 4H bucket.
        if qCount == 16 {
            addBar(qO, qH, qL, qC, qV, qOpen, qHigh, qLow, close, qVolume)
            h4Closed := buildSnapshot(qO, qH, qL, qC, qV)
            cacheFlatLevels(h4FlatLevels, qH, qL, qC, h4Closed)
        }
        qCount := 0
    }
}

TfSnap m15 = buildSnapshot(mO, mH, mL, mC, mV)
TfSnap h1 = h1Closed
TfSnap h4 = h4Closed

bool dataReady = confirmed15m and m15.ready and h1.ready and h4.ready
float mTop = math.max(m15.currentA, m15.currentB)
float mBottom = math.min(m15.currentA, m15.currentB)
float hTop = math.max(h1.currentA, h1.currentB)
float hBottom = math.min(h1.currentA, h1.currentB)
float qTop = math.max(h4.currentA, h4.currentB)
float qBottom = math.min(h4.currentA, h4.currentB)

bool hAbove = h1.c > hTop
bool hBelow = h1.c < hBottom
bool qAbove = h4.c > qTop
bool qBelow = h4.c < qBottom
bool mAbove = m15.c > mTop
bool mBelow = m15.c < mBottom
bool bullishBias = hAbove or (qAbove and mAbove)
bool bearishBias = hBelow or (qBelow and mBelow)
bool isLong = bullishBias and not bearishBias ? true : bearishBias and not bullishBias ? false : h1.tenkan >= h1.kijun

bool hSanyakuBull = h1.c > hTop and h1.tenkan >= h1.kijun - h1.atr * 0.05 and h1.kijun >= hBottom - h1.atr * 0.10
bool hSanyakuBear = h1.c < hBottom and h1.tenkan <= h1.kijun + h1.atr * 0.05 and h1.kijun <= hTop + h1.atr * 0.10
bool mSanyakuBull = m15.c > mTop and m15.tenkan >= m15.kijun - m15.atr * 0.05 and m15.kijun >= mBottom - m15.atr * 0.10
bool mSanyakuBear = m15.c < mBottom and m15.tenkan <= m15.kijun + m15.atr * 0.05 and m15.kijun <= mTop + m15.atr * 0.10

// ── The 17 BASE_ICHIMOKU rules ────────────────────────────────────────────
bool c1 = isLong ? (hAbove and mAbove and not qBelow) : (hBelow and mBelow and not qAbove)
bool c2 = isLong ? (hSanyakuBull and mSanyakuBull) : (hSanyakuBear and mSanyakuBear)
bool c3 = isLong ? (h1.tenkan >= h1.kijun and h1.tenkan >= h1.prevTenkan - h1.atr * 0.05 and h1.kijun >= h1.prevKijun - h1.atr * 0.02 and m15.tenkan >= m15.prevTenkan - m15.atr * 0.05) : (h1.tenkan <= h1.kijun and h1.tenkan <= h1.prevTenkan + h1.atr * 0.05 and h1.kijun <= h1.prevKijun + h1.atr * 0.02 and m15.tenkan <= m15.prevTenkan + m15.atr * 0.05)
bool hFutureBull = h1.futureA > h1.futureB
bool hFutureBear = h1.futureA < h1.futureB
bool mFutureBull = m15.futureA > m15.futureB
bool mFutureBear = m15.futureA < m15.futureB
bool c4 = isLong ? (hFutureBull and h1.futureA >= h1.prevFutureA and h1.futureB >= h1.prevFutureB and mFutureBull) : (hFutureBear and h1.futureA <= h1.prevFutureA and h1.futureB <= h1.prevFutureB and mFutureBear)
bool c5 = h1.futureThickness >= 0.05 and m15.futureThickness >= 0.04
bool c6 = isLong ? (h1.chikouBull and m15.chikouBull) : (h1.chikouBear and m15.chikouBear)
bool c7 = isLong ? m15.c >= m15.chikouPeak - m15.atr * 0.15 : m15.c <= m15.chikouTrough + m15.atr * 0.15
bool c8 = h1.cClamp == false and m15.cClamp == false and math.abs(h1.c - h1.kijun) / math.max(h1.atr, 0.00000001) <= maxKijunExtensionAtr
float gravityBuffer = (m15.ssbFlat or h1.ssbFlat) ? m15.atr * 0.15 : 0.0
bool c9 = isLong ? m15.c >= mTop + gravityBuffer : m15.c <= mBottom - gravityBuffer

HosodaWave wave = buildWave(hH, hL, h1, isLong)
bool c10 = not wave.valid or (wave.sHeld and not (wave.nearCycle and m15.tenkanFlat))
bool directionalCandle = isLong ? (m15.c > m15.o and m15.clv >= 0.45 and m15.body >= 0.22) : (m15.c < m15.o and m15.clv <= 0.55 and m15.body >= 0.22)
bool c11 = directionalCandle and m15.volumeRatio >= minVolumeRatio
bool dualFlatChop = h1.kijunFlat and h1.ssbFlat and m15.kijunFlat and m15.ssbFlat and h1.er < minEr
bool htfCounterTrap = isLong ? (m15.c > m15.kijun and h1.c < h1.kijun - h1.atr * 0.25) : (m15.c < m15.kijun and h1.c > h1.kijun + h1.atr * 0.25)
bool c13 = (h1.er >= minEr or m15.er >= minEr + 0.02) and not dualFlatChop and not htfCounterTrap
bool c14 = (isLong ? m15.upperWick : m15.lowerWick) <= maxAdverseWick and (m15.body >= 0.22 or (isLong ? m15.lowerWick : m15.upperWick) >= 0.25)

// Standard BASE triggers: EARLY_KATANA, PULLBACK, BREAKOUT, SANYAKU.
int mSize = array.length(mC)
float p1c = mSize >= 2 ? array.get(mC, mSize - 2) : na
float p2c = mSize >= 3 ? array.get(mC, mSize - 3) : na
float p1h = mSize >= 2 ? array.get(mH, mSize - 2) : na
float p2h = mSize >= 3 ? array.get(mH, mSize - 3) : na
float p1l = mSize >= 2 ? array.get(mL, mSize - 2) : na
float p2l = mSize >= 3 ? array.get(mL, mSize - 3) : na
float p3l = mSize >= 4 ? array.get(mL, mSize - 4) : na
float p3h = mSize >= 4 ? array.get(mH, mSize - 4) : na
float p3c = mSize >= 4 ? array.get(mC, mSize - 4) : na
float breakoutBuffer = (m15.ssbFlat or h1.ssbFlat) ? m15.atr * 0.15 : m15.atr * 0.03
bool triggerKatana = isLong ? (m15.katanaRelease and m15.c > m15.o and m15.c > math.max(m15.tenkan, m15.kijun) and m15.c > mTop and m15.chikouBull and math.abs(m15.c - m15.kijun) / math.max(m15.atr, 0.00000001) <= 1.15) : (m15.katanaRelease and m15.c < m15.o and m15.c < math.min(m15.tenkan, m15.kijun) and m15.c < mBottom and m15.chikouBear and math.abs(m15.c - m15.kijun) / math.max(m15.atr, 0.00000001) <= 1.15)
bool touchedEquilibrium = isLong ? ((p1l <= math.max(m15.tenkan, m15.kijun) + m15.atr * 0.35 and p1c >= m15.kijun - m15.atr * 0.20) or (p2l <= math.max(m15.tenkan, m15.kijun) + m15.atr * 0.35 and p2c >= m15.kijun - m15.atr * 0.20) or (p3l <= math.max(m15.tenkan, m15.kijun) + m15.atr * 0.35 and p3c >= m15.kijun - m15.atr * 0.20) or (m15.l <= math.max(m15.tenkan, m15.kijun) + m15.atr * 0.35 and m15.c >= m15.kijun - m15.atr * 0.20)) : ((p1h >= math.min(m15.tenkan, m15.kijun) - m15.atr * 0.35 and p1c <= m15.kijun + m15.atr * 0.20) or (p2h >= math.min(m15.tenkan, m15.kijun) - m15.atr * 0.35 and p2c <= m15.kijun + m15.atr * 0.20) or (p3h >= math.min(m15.tenkan, m15.kijun) - m15.atr * 0.35 and p3c <= m15.kijun + m15.atr * 0.20) or (m15.h >= math.min(m15.tenkan, m15.kijun) - m15.atr * 0.35 and m15.c <= m15.kijun + m15.atr * 0.20))
bool triggerPullback = isLong ? (touchedEquilibrium and m15.c > m15.o and m15.c >= m15.tenkan and m15.c > mTop) : (touchedEquilibrium and m15.c < m15.o and m15.c <= m15.tenkan and m15.c < mBottom)
bool triggerValidatedBreakout = isLong ? ((p1c <= mTop or p2c <= mTop or p1c <= m15.kijun) and m15.c > math.max(mTop, m15.kijun) + breakoutBuffer and m15.c >= m15.chikouPeak + breakoutBuffer and m15.c > m15.o) : ((p1c >= mBottom or p2c >= mBottom or p1c >= m15.kijun) and m15.c < math.min(mBottom, m15.kijun) - breakoutBuffer and m15.c <= m15.chikouTrough - breakoutBuffer and m15.c < m15.o)
bool triggerSanyaku = isLong ? (mSanyakuBull and m15.bullImpulse and m15.c >= math.max(p1h, p2h) and math.abs(m15.c - m15.kijun) / math.max(m15.atr, 0.00000001) <= maxKijunExtensionAtr * 0.85) : (mSanyakuBear and m15.bearImpulse and m15.c <= math.min(p1l, p2l) and math.abs(m15.c - m15.kijun) / math.max(m15.atr, 0.00000001) <= maxKijunExtensionAtr * 0.85)
bool triggerFired = triggerKatana or triggerPullback or triggerValidatedBreakout or triggerSanyaku

// Sniper entry and structural plan corridor. The cost defaults are the source's
// USDT benchmark: 10 bps/side commission + 1 bp spread = 21 bps round trip.
float candlePocket = isLong ? m15.l + (m15.h - m15.l) * 0.55 : m15.h - (m15.h - m15.l) * 0.55
float sniper = isLong ? math.max(m15.tenkan, math.min(m15.c, candlePocket)) : math.min(m15.tenkan, math.max(m15.c, candlePocket))
// This ports the four-school structural-stop priority used by BASE:
// Kijun26, Kijun30/EMA34, fractal, current Kumo edge, then Hosoda S.
// The source passes the more conservative of anchor and live price to the
// structural-anchor chooser, then sanitizes the result around the sniper entry.
float planBaseEntry = isLong ? math.min(sniper, m15.c) : math.max(sniper, m15.c)
float planAtrFloor = planBaseEntry * 0.016 / 9.0
float planAtrCeiling = planBaseEntry * 0.016 / 1.6
float planRobustAtr = math.min(math.max(m15.atr, planAtrFloor), planAtrCeiling)
float strategyAtrFloor = planBaseEntry * 0.016 / 9.0
float strategyAtrCeiling = planBaseEntry * 0.016 / 1.6
float planStrategyAtr = math.min(math.max(h1.atr, strategyAtrFloor), strategyAtrCeiling)
float safeFloor = math.max(planBaseEntry * 0.0025, math.max(planBaseEntry * 0.0006, math.max(planRobustAtr * 0.82, planStrategyAtr * 0.28)))
float venueFloor = math.min(planBaseEntry * 0.0004, planBaseEntry * 0.016)
float stopFloor = math.min(planBaseEntry * 0.016, math.max(safeFloor, math.max(planBaseEntry * 0.0016, math.max(planRobustAtr * 0.80, venueFloor))))
float stopCeiling = math.max(planBaseEntry * 0.0016, math.min(planBaseEntry * 0.016, planRobustAtr * 2.10))
float adverseWick = isLong ? m15.lowerWick : m15.upperWick
float slShield = planRobustAtr * (math.min(math.max(slBufferAtr, 0.18), 0.42) + 0.16 * math.min(math.max(adverseWick, 0.0), 0.65))
float costFloor = planBaseEntry * math.min(roundTripCostPct * 2.20, 0.045)
stopFloor := math.max(stopFloor, costFloor)

float anchor1 = isLong ? m15.kijun - slShield : m15.kijun + slShield
float anchor2 = isLong ? math.min(m15.kijun30, m15.ema34) - slShield * 0.90 : math.max(m15.kijun30, m15.ema34) + slShield * 0.90
float anchor3 = isLong ? math.min(m15.downFractal, m15.l) - slShield : math.max(m15.upFractal, m15.h) + slShield
float anchor4 = isLong ? mBottom - slShield * 0.85 : mTop + slShield * 0.85
float anchor5 = isLong ? (wave.valid ? wave.c : m15.kijun) - slShield : (wave.valid ? wave.c : m15.kijun) + slShield
bool validAnchor1 = isLong ? (anchor1 > 0.0 and anchor1 < planBaseEntry) : anchor1 > planBaseEntry
bool validAnchor2 = isLong ? (anchor2 > 0.0 and anchor2 < planBaseEntry) : anchor2 > planBaseEntry
bool validAnchor3 = isLong ? (anchor3 > 0.0 and anchor3 < planBaseEntry) : anchor3 > planBaseEntry
bool validAnchor4 = isLong ? (anchor4 > 0.0 and anchor4 < planBaseEntry) : anchor4 > planBaseEntry
bool validAnchor5 = isLong ? (anchor5 > 0.0 and anchor5 < planBaseEntry) : anchor5 > planBaseEntry
float anchorDistance1 = math.abs(planBaseEntry - anchor1)
float anchorDistance2 = math.abs(planBaseEntry - anchor2)
float anchorDistance3 = math.abs(planBaseEntry - anchor3)
float anchorDistance4 = math.abs(planBaseEntry - anchor4)
float anchorDistance5 = math.abs(planBaseEntry - anchor5)
float rawStructuralStop = na
if validAnchor1 and anchorDistance1 >= stopFloor and anchorDistance1 <= stopCeiling {
    rawStructuralStop := anchor1
} else if validAnchor2 and anchorDistance2 >= stopFloor and anchorDistance2 <= stopCeiling {
    rawStructuralStop := anchor2
} else if validAnchor3 and anchorDistance3 >= stopFloor and anchorDistance3 <= stopCeiling {
    rawStructuralStop := anchor3
} else if validAnchor4 and anchorDistance4 >= stopFloor and anchorDistance4 <= stopCeiling {
    rawStructuralStop := anchor4
} else if validAnchor5 and anchorDistance5 >= stopFloor and anchorDistance5 <= stopCeiling {
    rawStructuralStop := anchor5
}
if na(rawStructuralStop) {
    bool anyTooClose = (validAnchor1 and anchorDistance1 < stopFloor) or (validAnchor2 and anchorDistance2 < stopFloor) or (validAnchor3 and anchorDistance3 < stopFloor) or (validAnchor4 and anchorDistance4 < stopFloor) or (validAnchor5 and anchorDistance5 < stopFloor)
    if anyTooClose {
        rawStructuralStop := isLong ? planBaseEntry - stopFloor : planBaseEntry + stopFloor
    } else {
        float nearestAnchor = na
        float nearestDistance = 1000000000.0
        if validAnchor1 and anchorDistance1 < nearestDistance {
            nearestAnchor := anchor1
            nearestDistance := anchorDistance1
        }
        if validAnchor2 and anchorDistance2 < nearestDistance {
            nearestAnchor := anchor2
            nearestDistance := anchorDistance2
        }
        if validAnchor3 and anchorDistance3 < nearestDistance {
            nearestAnchor := anchor3
            nearestDistance := anchorDistance3
        }
        if validAnchor4 and anchorDistance4 < nearestDistance {
            nearestAnchor := anchor4
            nearestDistance := anchorDistance4
        }
        if validAnchor5 and anchorDistance5 < nearestDistance {
            nearestAnchor := anchor5
            nearestDistance := anchorDistance5
        }
        float selectedDistance = na(nearestAnchor) ? stopFloor : math.min(math.max(nearestDistance, stopFloor), stopCeiling)
        rawStructuralStop := isLong ? planBaseEntry - selectedDistance : planBaseEntry + selectedDistance
    }
}
float rawStopDistance = math.max(math.abs(sniper - rawStructuralStop), math.max(math.abs(m15.c - rawStructuralStop), safeFloor))

bool c15 = c13 and c8 and not (wave.barsSinceA > 55 and m15.tenkanFlat and h1.tenkanFlat)
float phaseBonus = not c13 or dualFlatChop ? 0.0 : (wave.barsSinceA <= 18 or m15.katanaRelease or triggerKatana ? 0.25 : 0.12)
float erBonus = math.min(0.35, math.max(-0.15, (h1.er + m15.er - 0.50) * 0.45))
float volumeBonus = m15.volumeRatio >= 1.20 ? 0.12 : 0.0
float desiredRr = r2(math.min(3.0, math.max(1.5, 2.25 + phaseBonus + erBonus + volumeBonus)))
float minimumRr = 1.5
float nearestH1 = nearestCachedFlat(h1FlatLevels, isLong, m15.c, m15.atr)
float nearestH4 = nearestCachedFlat(h4FlatLevels, isLong, m15.c, m15.atr)
float obstacle = na(nearestH1) ? nearestH4 : na(nearestH4) ? nearestH1 : (isLong ? math.min(nearestH1, nearestH4) : math.max(nearestH1, nearestH4))
float selectedWaveTarget = isLong ? sniper + rawStopDistance * desiredRr : sniper - rawStopDistance * desiredRr
if wave.valid {
    float candidate1 = wave.targetNT
    float candidate2 = wave.targetV
    float candidate3 = wave.targetN
    float candidate4 = wave.targetE
    float minDistance1 = math.min(math.abs(candidate1 - m15.c), math.abs(candidate1 - sniper))
    float minDistance2 = math.min(math.abs(candidate2 - m15.c), math.abs(candidate2 - sniper))
    float minDistance3 = math.min(math.abs(candidate3 - m15.c), math.abs(candidate3 - sniper))
    float minDistance4 = math.min(math.abs(candidate4 - m15.c), math.abs(candidate4 - sniper))
    float maxDistance1 = math.max(math.abs(candidate1 - m15.c), math.abs(candidate1 - sniper))
    float maxDistance2 = math.max(math.abs(candidate2 - m15.c), math.abs(candidate2 - sniper))
    float maxDistance3 = math.max(math.abs(candidate3 - m15.c), math.abs(candidate3 - sniper))
    float maxDistance4 = math.max(math.abs(candidate4 - m15.c), math.abs(candidate4 - sniper))
    bool valid1 = (isLong ? candidate1 > math.max(m15.c, sniper) : candidate1 < math.min(m15.c, sniper)) and minDistance1 / math.max(rawStopDistance, 0.00000001) >= minimumRr and maxDistance1 / math.max(rawStopDistance, 0.00000001) <= 3.0
    bool valid2 = (isLong ? candidate2 > math.max(m15.c, sniper) : candidate2 < math.min(m15.c, sniper)) and minDistance2 / math.max(rawStopDistance, 0.00000001) >= minimumRr and maxDistance2 / math.max(rawStopDistance, 0.00000001) <= 3.0
    bool valid3 = (isLong ? candidate3 > math.max(m15.c, sniper) : candidate3 < math.min(m15.c, sniper)) and minDistance3 / math.max(rawStopDistance, 0.00000001) >= minimumRr and maxDistance3 / math.max(rawStopDistance, 0.00000001) <= 3.0
    bool valid4 = (isLong ? candidate4 > math.max(m15.c, sniper) : candidate4 < math.min(m15.c, sniper)) and minDistance4 / math.max(rawStopDistance, 0.00000001) >= minimumRr and maxDistance4 / math.max(rawStopDistance, 0.00000001) <= 3.0
    float bestDifference = 1000000000.0
    float bestTarget = selectedWaveTarget
    float rr1 = math.abs(candidate1 - sniper) / math.max(rawStopDistance, 0.00000001)
    float rr2 = math.abs(candidate2 - sniper) / math.max(rawStopDistance, 0.00000001)
    float rr3 = math.abs(candidate3 - sniper) / math.max(rawStopDistance, 0.00000001)
    float rr4 = math.abs(candidate4 - sniper) / math.max(rawStopDistance, 0.00000001)
    if valid1 {
        bestTarget := candidate1
        bestDifference := math.abs(rr1 - desiredRr)
    }
    if valid2 and math.abs(rr2 - desiredRr) < bestDifference {
        bestTarget := candidate2
        bestDifference := math.abs(rr2 - desiredRr)
    }
    if valid3 and math.abs(rr3 - desiredRr) < bestDifference {
        bestTarget := candidate3
        bestDifference := math.abs(rr3 - desiredRr)
    }
    if valid4 and math.abs(rr4 - desiredRr) < bestDifference {
        bestTarget := candidate4
    }
    selectedWaveTarget := bestTarget
}
if not na(obstacle) {
    float obstacleDistance = math.min(math.abs(obstacle - m15.c), math.abs(obstacle - sniper))
    if obstacleDistance / math.max(rawStopDistance, 0.00000001) >= minimumRr {
        float bufferedObstacle = isLong ? obstacle - m15.atr * 0.08 : obstacle + m15.atr * 0.08
        float candidateTarget = isLong ? math.min(selectedWaveTarget, bufferedObstacle) : math.max(selectedWaveTarget, bufferedObstacle)
        float candidateDistance = math.min(math.abs(candidateTarget - m15.c), math.abs(candidateTarget - sniper))
        if candidateDistance / math.max(rawStopDistance, 0.00000001) >= minimumRr {
            selectedWaveTarget := candidateTarget
        }
    }
}
float rawTargetPrice = isLong ? math.min(math.max(selectedWaveTarget, sniper + rawStopDistance * minimumRr), sniper + rawStopDistance * 3.0) : math.max(math.min(selectedWaveTarget, sniper - rawStopDistance * minimumRr), sniper - rawStopDistance * 3.0)

// M15 TradePlanGuard corridor around the sniper price. Tick rounding depends on
// the selected GoCharting symbol and is left to the broker/chart precision.
float sniperAtrFloor = sniper * 0.016 / 9.0
float sniperAtrCeiling = sniper * 0.016 / 1.6
float sniperRobustAtr = math.min(math.max(m15.atr, sniperAtrFloor), sniperAtrCeiling)
float sniperStrategyAtr = math.min(math.max(h1.atr, sniperAtrFloor), sniperAtrCeiling)
float sniperSafeFloor = math.max(sniper * 0.0025, math.max(sniper * 0.0006, math.max(sniperRobustAtr * 0.82, sniperStrategyAtr * 0.28)))
float guardFloor = math.min(sniper * 0.016, math.max(sniperSafeFloor, math.max(sniper * 0.0016, math.max(sniperRobustAtr * 0.80, sniper * 0.0004))))
float guardCeiling = math.max(guardFloor, math.max(sniper * 0.0016, math.min(sniper * 0.016, sniperRobustAtr * 2.10)))
float targetCeiling = math.max(guardFloor * 1.5, math.min(sniper * 0.0288, sniperRobustAtr * 3.40) * 0.995)
float guardStopCeiling = math.max(guardFloor, math.min(guardCeiling, targetCeiling / desiredRr) * 0.995)
float rawAnchorStopDistance = isLong ? (rawStructuralStop < sniper ? sniper - rawStructuralStop : 0.0) : (rawStructuralStop > sniper ? rawStructuralStop - sniper : 0.0)
float stopDistance = math.min(math.max(rawAnchorStopDistance > 0.0 ? rawAnchorStopDistance : guardFloor, guardFloor), guardStopCeiling)
float rawAnchorTargetDistance = isLong ? (rawTargetPrice > sniper ? rawTargetPrice - sniper : 0.0) : (rawTargetPrice < sniper ? sniper - rawTargetPrice : 0.0)
float structuredTarget = rawAnchorTargetDistance / math.max(stopDistance, 0.00000001) >= 1.5 ? rawAnchorTargetDistance : stopDistance * desiredRr
float upperTarget = math.max(stopDistance * 1.5, math.min(stopDistance * 3.0, targetCeiling))
float feeFloor = sniper * roundTripCostPct * 2.0
bool planUsable = upperTarget >= feeFloor
float targetDistance = planUsable ? math.min(math.max(structuredTarget, math.max(stopDistance * 1.5, feeFloor)), upperTarget) : 0.0
float stopPrice = isLong ? sniper - stopDistance : sniper + stopDistance
float targetPrice = isLong ? sniper + targetDistance : sniper - targetDistance
float rr = targetDistance / math.max(stopDistance, 0.00000001)
float obstacleDistanceForGate = na(obstacle) ? 1000000000.0 : math.min(math.abs(obstacle - m15.c), math.abs(obstacle - sniper))
bool obstacleClear = na(obstacle) or obstacleDistanceForGate / math.max(stopDistance, 0.00000001) >= minimumRr
bool c12 = planUsable and rr >= minimumRr and rr <= 3.0 and obstacleClear
float sniperDistance = math.abs(m15.c - sniper) / math.max(m15.atr, 0.00000001)
float tenkanDistance = math.abs(m15.c - m15.tenkan) / math.max(m15.atr, 0.00000001)
bool c16 = sniperDistance <= 0.35 and tenkanDistance <= 0.85
float costToRisk = roundTripCostPct * sniper / math.max(stopDistance, 0.00000001)
bool c17 = costToRisk <= 0.45

// The reference book gate: hard veto 1/3/4/6/17; condition 17 is counted in
// both its regime and trigger layers, exactly as the Kotlin implementation.
float regimeScore = (c1 ? 1.0 : 0.0) + (c3 ? 1.0 : 0.0) + (c4 ? 1.0 : 0.0) + (c6 ? 1.0 : 0.0) + (c17 ? 1.2 : 0.0)
float qualityScore = (c5 ? 0.6 : 0.0) + (c8 ? 1.0 : 0.0) + (c9 ? 1.0 : 0.0) + (c13 ? 1.0 : 0.0) + (c14 ? 0.6 : 0.0) + (c15 ? 1.0 : 0.0)
float triggerScore = (c2 ? 0.6 : 0.0) + (c7 ? 0.6 : 0.0) + (c10 ? 0.8 : 0.0) + (c11 ? 1.2 : 0.0) + (c12 ? 1.0 : 0.0) + (c16 ? 1.2 : 0.0) + (c17 ? 1.2 : 0.0)
float regimePct = regimeScore / 5.2 * 100.0
float qualityPct = qualityScore / 5.2 * 100.0
float triggerPct = triggerScore / 6.6 * 100.0
float bookPct = (regimeScore + qualityScore + triggerScore) / 17.0 * 100.0
bool hardVetoPassed = c1 and c3 and c4 and c6 and c17
bool bookFires = hardVetoPassed and qualityPct >= 60.0 and triggerPct >= 60.0 and bookPct >= 70.0
bool all17 = c1 and c2 and c3 and c4 and c5 and c6 and c7 and c8 and c9 and c10 and c11 and c12 and c13 and c14 and c15 and c16 and c17
bool baseSignal = dataReady and triggerFired and c12 and (all17 or bookFires)
int passedCount = (c1 ? 1 : 0) + (c2 ? 1 : 0) + (c3 ? 1 : 0) + (c4 ? 1 : 0) + (c5 ? 1 : 0) + (c6 ? 1 : 0) + (c7 ? 1 : 0) + (c8 ? 1 : 0) + (c9 ? 1 : 0) + (c10 ? 1 : 0) + (c11 ? 1 : 0) + (c12 ? 1 : 0) + (c13 ? 1 : 0) + (c14 ? 1 : 0) + (c15 ? 1 : 0) + (c16 ? 1 : 0) + (c17 ? 1 : 0)
float confidence = math.min(100.0, (passedCount / 17.0) * 84.0 + (triggerFired ? 16.0 : 0.0))

// Orders are intentionally submitted after a confirmed 15m close. GoCharting
// fills a market entry on the next candle open because process_orders_on_close=false.
static int pendingSide = 0
static int pendingSignalBar = na
static float pendingStopDistance = na
static float pendingTargetDistance = na
static int heldBars = 0
// A market signal submitted at a close is consumed at the next bar open. Clear
// the marker even if its bracket filled and closed within that same fill bar.
if pendingSide != 0 and bar_index > pendingSignalBar {
    pendingSide := 0
    pendingSignalBar := na
}
if strategy.position_size != 0 {
    heldBars += 1
} else {
    heldBars := 0
}

bool flatAndReady = strategy.position_size == 0 and pendingSide == 0
bool enterLong = dataReady and flatAndReady and allowLong and baseSignal and isLong
bool enterShort = dataReady and flatAndReady and allowShort and baseSignal and not isLong
if enterLong {
    pendingSide := 1
    pendingSignalBar := bar_index
    pendingStopDistance := stopDistance
    pendingTargetDistance := targetDistance
    strategy.entry("BASE Long", strategy.long, qty=qty, comment="BASE 4TF long")
    // Bracket is submitted with the next-open order. The distance-based update
    // below then performs the source model's same-offset rebase after it fills.
    strategy.exit("BASE Long exit", from_entry="BASE Long", stop=stopPrice, limit=targetPrice)
} else if enterShort {
    pendingSide := -1
    pendingSignalBar := bar_index
    pendingStopDistance := stopDistance
    pendingTargetDistance := targetDistance
    strategy.entry("BASE Short", strategy.short, qty=qty, comment="BASE 4TF short")
    strategy.exit("BASE Short exit", from_entry="BASE Short", stop=stopPrice, limit=targetPrice)
}

float activeStop = na
float activeTarget = na
if strategy.position_size > 0 {
    activeStop := strategy.position_avg_price - pendingStopDistance
    activeTarget := strategy.position_avg_price + pendingTargetDistance
    strategy.exit("BASE Long exit", from_entry="BASE Long", stop=activeStop, limit=activeTarget)
    if heldBars >= maxHoldBars {
        strategy.close("BASE Long", comment="20-bar time stop")
    }
} else if strategy.position_size < 0 {
    activeStop := strategy.position_avg_price + pendingStopDistance
    activeTarget := strategy.position_avg_price - pendingTargetDistance
    strategy.exit("BASE Short exit", from_entry="BASE Short", stop=activeStop, limit=activeTarget)
    if heldBars >= maxHoldBars {
        strategy.close("BASE Short", comment="20-bar time stop")
    }
}

// ── Visual audit layer ─────────────────────────────────────────────────────
plot(m15.tenkan, title="15m Tenkan", color=color.blue, linewidth=2)
plot(m15.kijun, title="15m Kijun", color=color.orange, linewidth=2)
plot(m15.currentA, title="15m current Span A", color=color.green)
plot(m15.currentB, title="15m current Span B", color=color.red)
plot(h1.kijun, title="Built 1H Kijun", color=color.new(color.orange, 0.50), linewidth=1, style=plotStyle.linebr)
plot(h4.kijun, title="Built 4H Kijun", color=color.new(color.purple, 0.40), linewidth=1, style=plotStyle.linebr)
plot(activeStop, title="Active structural SL", color=color.red, linewidth=2, style=plotStyle.linebr)
plot(activeTarget, title="Active guarded TP", color=color.green, linewidth=2, style=plotStyle.linebr)
plotshape(enterLong, title="BASE long", location=location.belowbar, shape=shape.triangleup, color=color.lime, size=size.normal, text="BASE L")
plotshape(enterShort, title="BASE short", location=location.abovebar, shape=shape.triangledown, color=color.red, size=size.normal, text="BASE S")
plotshape(showNearMiss and dataReady and triggerFired and c1 and c3 and c4 and c6 and not c17, title="Cost veto", location=location.abovebar, shape=shape.xcross, color=color.orange, size=size.tiny, text="C17")
plotshape(showNearMiss and dataReady and triggerFired and not hardVetoPassed, title="Hard veto", location=location.abovebar, shape=shape.circle, color=color.purple, size=size.tiny, text="V")
barcolor(enterLong ? color.new(color.lime, 0.15) : enterShort ? color.new(color.red, 0.15) : na)

// The small audit labels retain the decision state at the bar. They are for
// debugging only and do not alter orders. Old labels are pruned locally before
// the platform's drawing limit is reached.
static array<label> auditLabels = array.new<label>(0)
if enterLong or enterShort {
    string sideText = enterLong ? "BASE LONG" : "BASE SHORT"
    string triggerText = triggerKatana ? "KATANA" : triggerPullback ? "PULLBACK" : triggerValidatedBreakout ? "BREAKOUT" : "SANYAKU"
    string auditText = sideText + "\n" + triggerText + " | " + str.tostring(passedCount) + "/17" + "\nGate " + str.tostring(bookPct, "#.0") + "%" + " | RR " + str.tostring(rr, "#.00") + "\nSL " + str.tostring(stopPrice) + " TP " + str.tostring(targetPrice)
    label marker = label.new(bar_index, enterLong ? low : high, auditText, yloc=enterLong ? yloc.belowbar : yloc.abovebar, style=enterLong ? label.style_label_up : label.style_label_down, color=enterLong ? color.lime : color.red, textcolor=color.white, size=size.small)
    array.push(auditLabels, marker)
    if array.length(auditLabels) > 250 {
        label.delete(array.shift(auditLabels))
    }
}
if showNearMiss and dataReady and triggerFired and not baseSignal {
    string vetoText = not c1 ? "C1" : not c3 ? "C3" : not c4 ? "C4" : not c6 ? "C6" : not c17 ? "C17" : not c12 ? "C12" : bookPct < 70.0 ? "GATE" : "QUALITY"
    string failedList = ""
    if not c1 {
        failedList := failedList + " 1"
    }
    if not c2 {
        failedList := failedList + " 2"
    }
    if not c3 {
        failedList := failedList + " 3"
    }
    if not c4 {
        failedList := failedList + " 4"
    }
    if not c5 {
        failedList := failedList + " 5"
    }
    if not c6 {
        failedList := failedList + " 6"
    }
    if not c7 {
        failedList := failedList + " 7"
    }
    if not c8 {
        failedList := failedList + " 8"
    }
    if not c9 {
        failedList := failedList + " 9"
    }
    if not c10 {
        failedList := failedList + " 10"
    }
    if not c11 {
        failedList := failedList + " 11"
    }
    if not c12 {
        failedList := failedList + " 12"
    }
    if not c13 {
        failedList := failedList + " 13"
    }
    if not c14 {
        failedList := failedList + " 14"
    }
    if not c15 {
        failedList := failedList + " 15"
    }
    if not c16 {
        failedList := failedList + " 16"
    }
    if not c17 {
        failedList := failedList + " 17"
    }
    string rejectText = "REJECT " + vetoText + "\n" + str.tostring(passedCount) + "/17 | Gate " + str.tostring(bookPct, "#.0") + "%" + "\nFailed C:" + failedList
    label rejected = label.new(bar_index, isLong ? high : low, rejectText, yloc=isLong ? yloc.abovebar : yloc.belowbar, style=isLong ? label.style_label_down : label.style_label_up, color=color.new(color.gray, 0.20), textcolor=color.white, size=size.tiny)
    array.push(auditLabels, rejected)
    if array.length(auditLabels) > 250 {
        label.delete(array.shift(auditLabels))
    }
}

static table dashboard = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 0.20), border_width=1)
if barstate.islast {
    table.cell(dashboard, 0, 0, "BASE 4TF audit")
    table.cell(dashboard, 1, 0, chartIs15m ? "15m OK" : "CHANGE TO 15m", textcolor=chartIs15m ? color.lime : color.red)
    table.cell(dashboard, 0, 1, "Data / bias")
    table.cell(dashboard, 1, 1, dataReady ? (isLong ? "READY / LONG" : "READY / SHORT") : "WARM-UP", textcolor=dataReady ? color.white : color.orange)
    table.cell(dashboard, 0, 2, "HTF closed bars")
    table.cell(dashboard, 1, 2, "1H " + str.tostring(array.length(hC)) + " | 4H " + str.tostring(array.length(qC)))
    table.cell(dashboard, 0, 3, "Conditions")
    table.cell(dashboard, 1, 3, str.tostring(passedCount) + " / 17", textcolor=passedCount >= 14 ? color.lime : color.orange)
    table.cell(dashboard, 0, 4, "Book gate")
    table.cell(dashboard, 1, 4, str.tostring(bookPct, "#.0") + "%", textcolor=bookFires ? color.lime : color.orange)
    table.cell(dashboard, 0, 5, "Layers")
    table.cell(dashboard, 1, 5, "R " + str.tostring(regimePct, "#.0") + " Q " + str.tostring(qualityPct, "#.0") + " T " + str.tostring(triggerPct, "#.0"))
    table.cell(dashboard, 0, 6, "Trigger")
    table.cell(dashboard, 1, 6, triggerKatana ? "KATANA" : triggerPullback ? "PULLBACK" : triggerValidatedBreakout ? "BREAKOUT" : triggerSanyaku ? "SANYAKU" : "-", textcolor=triggerFired ? color.lime : color.gray)
    table.cell(dashboard, 0, 7, "Plan")
    table.cell(dashboard, 1, 7, "RR " + str.tostring(rr, "#.00") + " | cost " + str.tostring(costToRisk, "#.00"))
    table.cell(dashboard, 0, 8, "Status")
    table.cell(dashboard, 1, 8, baseSignal ? "SIGNAL: NEXT OPEN" : hardVetoPassed ? "NO TRIGGER/GATE" : "HARD VETO", textcolor=baseSignal ? color.lime : hardVetoPassed ? color.orange : color.red)
}
