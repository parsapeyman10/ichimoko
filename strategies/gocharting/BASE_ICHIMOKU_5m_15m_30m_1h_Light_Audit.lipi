//@lipi=2
// BASE_ICHIMOKU Lite visual audit for a standard 5-minute GoCharting chart.
//
// It builds ONLY completed 15m, 30m and 1H bars from five-minute candles.
// Mapping: 1H macro -> 30m strategy -> 15m confirmation -> 5m trigger.
// This is a low-cost diagnostic adaptation, not the original 4H/1H/15m model.
// GoCharting orders are simulated only and are never sent to an exchange.
strategy("BASE Ichimoku Lite audit (5m / 15m / 30m / 1H)", overlay=true, initial_capital=1000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission_percent, commission_value=0.105, pyramiding=0, process_orders_on_close=false)

int TENKAN = input.int(9, "Tenkan", minval=2)
int KIJUN = input.int(26, "Kijun", minval=2)
int SPAN_B = input.int(52, "Senkou B", minval=2)
int DISPLACEMENT = input.int(26, "Displacement", minval=2)
float qty = input.float(1.0, "Backtest quantity", minval=0.000001, step=0.01)
bool allowLong = input.bool(true, "Enable long")
bool allowShort = input.bool(true, "Enable short")
bool showDiagnosticMarkers = input.bool(false, "DEBUG: show rejected triggers")
bool debugVirtualTriggerTrades = input.bool(false, "DEBUG ONLY: simulate rejected triggers")
float maxKijunExtensionAtr = input.float(1.80, "Max Kijun extension (ATR)", minval=0.50, step=0.05)
float slBufferAtr = input.float(0.25, "Structural SL buffer (ATR)", minval=0.15, step=0.01)
float roundTripCostPct = input.float(0.0021, "Round-trip cost fraction", minval=0.0, step=0.0001)
int maxHoldBars = input.int(60, "Time stop: 5m bars", minval=1)

type LiteSnap {
    bool ready
    float o
    float h
    float l
    float c
    float tenkan
    float kijun
    float prevTenkan
    float prevKijun
    float currentA
    float currentB
    float futureA
    float futureB
    float prevFutureA
    float prevFutureB
    float atr
    bool chikouBull
    bool chikouBear
    float chikouPeak
    float chikouTrough
    bool ssbFlat
    bool kijunFlat
    float body
    float clv
    float volumeRatio
    float er
    float upperWick
    float lowerWick
}

func arrMax(array<float> values, int first, int last) {
    float best = array.get(values, first)
    if last > first {
        for i = first + 1 to last {
            best := math.max(best, array.get(values, i))
        }
    }
    return best
}

func arrMin(array<float> values, int first, int last) {
    float best = array.get(values, first)
    if last > first {
        for i = first + 1 to last {
            best := math.min(best, array.get(values, i))
        }
    }
    return best
}

func midpoint(array<float> highs, array<float> lows, int at, int length) {
    int first = math.max(0, at - length + 1)
    return (arrMax(highs, first, at) + arrMin(lows, first, at)) / 2.0
}

func addClosedBar(array<float> opens, array<float> highs, array<float> lows, array<float> closes, array<float> volumes, float o, float h, float l, float c, float v) {
    array.push(opens, o)
    array.push(highs, h)
    array.push(lows, l)
    array.push(closes, c)
    array.push(volumes, v)
    if array.length(closes) > 80 {
        array.shift(opens)
        array.shift(highs)
        array.shift(lows)
        array.shift(closes)
        array.shift(volumes)
    }
}

// Called only when an aggregated 15m/30m/1H bar has completed, never per 5m bar.
func makeSnapshot(array<float> opens, array<float> highs, array<float> lows, array<float> closes, array<float> volumes) {
    int n = array.length(closes)
    if n < SPAN_B + 5 {
        return LiteSnap.new(ready=false)
    }
    int last = n - 1
    int previous = last - 1
    int displaced = math.max(0, last - (DISPLACEMENT - 1))
    float t = midpoint(highs, lows, last, TENKAN)
    float k = midpoint(highs, lows, last, KIJUN)
    float previousT = midpoint(highs, lows, previous, TENKAN)
    float previousK = midpoint(highs, lows, previous, KIJUN)
    float currentA = (midpoint(highs, lows, displaced, TENKAN) + midpoint(highs, lows, displaced, KIJUN)) / 2.0
    float currentB = midpoint(highs, lows, displaced, SPAN_B)
    float futureA = (t + k) / 2.0
    float futureB = midpoint(highs, lows, last, SPAN_B)
    float previousFutureA = (previousT + previousK) / 2.0
    float previousFutureB = midpoint(highs, lows, previous, SPAN_B)

    int atrFirst = math.max(1, last - 13)
    float trSum = math.max(array.get(highs, atrFirst) - array.get(lows, atrFirst), math.max(math.abs(array.get(highs, atrFirst) - array.get(closes, atrFirst - 1)), math.abs(array.get(lows, atrFirst) - array.get(closes, atrFirst - 1))))
    if last > atrFirst {
        for i = atrFirst + 1 to last {
            float tr = math.max(array.get(highs, i) - array.get(lows, i), math.max(math.abs(array.get(highs, i) - array.get(closes, i - 1)), math.abs(array.get(lows, i) - array.get(closes, i - 1))))
            trSum += tr
        }
    }
    float c = array.get(closes, last)
    float atr = math.max(trSum / (last - atrFirst + 1), c * 0.0005)
    float topAtChikou = math.max(midpoint(highs, lows, displaced, TENKAN), midpoint(highs, lows, displaced, KIJUN))
    float bottomAtChikou = math.min(midpoint(highs, lows, displaced, TENKAN), midpoint(highs, lows, displaced, KIJUN))
    bool chikouBull = c > math.max(array.get(highs, displaced), topAtChikou)
    bool chikouBear = c < math.min(array.get(lows, displaced), bottomAtChikou)

    int peakFirst = math.max(0, last - KIJUN)
    float peak = array.get(closes, peakFirst)
    float trough = array.get(closes, peakFirst)
    if last - 1 > peakFirst {
        for i = peakFirst + 1 to last - 1 {
            peak := math.max(peak, array.get(closes, i))
            trough := math.min(trough, array.get(closes, i))
        }
    }

    float tolerance = math.max(c * 0.0003, atr * 0.04)
    float currentB1 = midpoint(highs, lows, math.max(0, displaced - 1), SPAN_B)
    float currentB2 = midpoint(highs, lows, math.max(0, displaced - 2), SPAN_B)
    bool ssbFlat = math.abs(currentB - currentB1) <= tolerance and math.abs(currentB - currentB2) <= tolerance
    bool kijunFlat = math.abs(k - previousK) <= tolerance
    float candleRange = math.max(array.get(highs, last) - array.get(lows, last), 0.00000001)
    float body = math.abs(c - array.get(opens, last)) / candleRange
    float clv = math.min(1.0, math.max(0.0, (c - array.get(lows, last)) / candleRange))

    int volumeFirst = math.max(0, last - 19)
    float volumeSum = array.get(volumes, volumeFirst)
    if last > volumeFirst {
        for i = volumeFirst + 1 to last {
            volumeSum += array.get(volumes, i)
        }
    }
    float averageVolume = volumeSum / (last - volumeFirst + 1)
    float volumeRatio = averageVolume > 0.0 and array.get(volumes, last) > 0.0 ? array.get(volumes, last) / averageVolume : 1.0

    int erFirst = math.max(0, last - 14)
    float erPath = 0.0
    if last > erFirst {
        for i = erFirst + 1 to last {
            erPath += math.abs(array.get(closes, i) - array.get(closes, i - 1))
        }
    }
    float er = erPath > 0.00000001 ? math.min(1.0, math.abs(c - array.get(closes, erFirst)) / erPath) : 0.5
    float upperWick = math.max(0.0, (array.get(highs, last) - math.max(array.get(opens, last), c)) / candleRange)
    float lowerWick = math.max(0.0, (math.min(array.get(opens, last), c) - array.get(lows, last)) / candleRange)

    return LiteSnap.new(ready=true, o=array.get(opens, last), h=array.get(highs, last), l=array.get(lows, last), c=c, tenkan=t, kijun=k, prevTenkan=previousT, prevKijun=previousK, currentA=currentA, currentB=currentB, futureA=futureA, futureB=futureB, prevFutureA=previousFutureA, prevFutureB=previousFutureB, atr=atr, chikouBull=chikouBull, chikouBear=chikouBear, chikouPeak=peak, chikouTrough=trough, ssbFlat=ssbFlat, kijunFlat=kijunFlat, body=body, clv=clv, volumeRatio=volumeRatio, er=er, upperWick=upperWick, lowerWick=lowerWick)
}

// Closed 15m, 30m and 1H arrays. Each is capped at 80 bars, enough for
// 52-period Ichimoku while keeping the script below GoCharting's time limit.
static array<float> o15 = array.new<float>(0)
static array<float> h15 = array.new<float>(0)
static array<float> l15 = array.new<float>(0)
static array<float> c15 = array.new<float>(0)
static array<float> v15 = array.new<float>(0)
static array<float> o30 = array.new<float>(0)
static array<float> h30 = array.new<float>(0)
static array<float> l30 = array.new<float>(0)
static array<float> c30 = array.new<float>(0)
static array<float> v30 = array.new<float>(0)
static array<float> o1h = array.new<float>(0)
static array<float> h1h = array.new<float>(0)
static array<float> l1h = array.new<float>(0)
static array<float> c1h = array.new<float>(0)
static array<float> v1h = array.new<float>(0)
static LiteSnap snap15 = LiteSnap.new(ready=false)
static LiteSnap snap30 = LiteSnap.new(ready=false)
static LiteSnap snap1h = LiteSnap.new(ready=false)
static int count15 = 0
static float bucket15Open = na
static float bucket15High = na
static float bucket15Low = na
static float bucket15Volume = 0.0
static int count30 = 0
static float bucket30Open = na
static float bucket30High = na
static float bucket30Low = na
static float bucket30Volume = 0.0
static int count1h = 0
static float bucket1hOpen = na
static float bucket1hHigh = na
static float bucket1hLow = na
static float bucket1hVolume = 0.0

bool chartIs5m = interval.isminutes and interval.multiplier == 5
bool closed5m = chartIs5m and barstate.isconfirmed
if closed5m {
    int utcMinute = minute(time, "UTC")

    // 15m: :00/:05/:10; :15/:20/:25; :30/:35/:40; :45/:50/:55.
    if utcMinute % 15 == 0 {
        bucket15Open := open
        bucket15High := high
        bucket15Low := low
        bucket15Volume := volume
        count15 := 1
    } else if count15 > 0 {
        bucket15High := math.max(bucket15High, high)
        bucket15Low := math.min(bucket15Low, low)
        bucket15Volume += volume
        count15 += 1
    }
    if utcMinute % 15 == 10 {
        if count15 == 3 {
            addClosedBar(o15, h15, l15, c15, v15, bucket15Open, bucket15High, bucket15Low, close, bucket15Volume)
            snap15 := makeSnapshot(o15, h15, l15, c15, v15)
        }
        count15 := 0
    }

    // 30m: six complete five-minute bars.
    if utcMinute == 0 or utcMinute == 30 {
        bucket30Open := open
        bucket30High := high
        bucket30Low := low
        bucket30Volume := volume
        count30 := 1
    } else if count30 > 0 {
        bucket30High := math.max(bucket30High, high)
        bucket30Low := math.min(bucket30Low, low)
        bucket30Volume += volume
        count30 += 1
    }
    if utcMinute == 25 or utcMinute == 55 {
        if count30 == 6 {
            addClosedBar(o30, h30, l30, c30, v30, bucket30Open, bucket30High, bucket30Low, close, bucket30Volume)
            snap30 := makeSnapshot(o30, h30, l30, c30, v30)
        }
        count30 := 0
    }

    // 1H: twelve complete five-minute bars.
    if utcMinute == 0 {
        bucket1hOpen := open
        bucket1hHigh := high
        bucket1hLow := low
        bucket1hVolume := volume
        count1h := 1
    } else if count1h > 0 {
        bucket1hHigh := math.max(bucket1hHigh, high)
        bucket1hLow := math.min(bucket1hLow, low)
        bucket1hVolume += volume
        count1h += 1
    }
    if utcMinute == 55 {
        if count1h == 12 {
            addClosedBar(o1h, h1h, l1h, c1h, v1h, bucket1hOpen, bucket1hHigh, bucket1hLow, close, bucket1hVolume)
            snap1h := makeSnapshot(o1h, h1h, l1h, c1h, v1h)
        }
        count1h := 0
    }
}

// Native 5m Ichimoku uses GoCharting's optimized talib functions.
float tenkan5 = (talib.highest(high, TENKAN) + talib.lowest(low, TENKAN)) / 2.0
float kijun5 = (talib.highest(high, KIJUN) + talib.lowest(low, KIJUN)) / 2.0
float spanA5 = (tenkan5 + kijun5) / 2.0
float spanB5 = (talib.highest(high, SPAN_B) + talib.lowest(low, SPAN_B)) / 2.0
float currentA5 = spanA5[DISPLACEMENT - 1]
float currentB5 = spanB5[DISPLACEMENT - 1]
float top5 = math.max(currentA5, currentB5)
float bottom5 = math.min(currentA5, currentB5)
float atr5 = math.max(talib.atr(14), close * 0.0005)
float priorHigh5 = talib.highest(high[1], 20)
float priorLow5 = talib.lowest(low[1], 20)
float chikouPeak5 = talib.highest(close[1], KIJUN)
float chikouTrough5 = talib.lowest(close[1], KIJUN)
float volumeAverage5 = talib.sma(volume, 20)
float volumeRatio5 = volumeAverage5 > 0.0 ? volume / volumeAverage5 : 1.0
float range5 = math.max(high - low, 0.00000001)
float body5 = math.abs(close - open) / range5
float clv5 = math.min(1.0, math.max(0.0, (close - low) / range5))
float upperWick5 = math.max(0.0, (high - math.max(open, close)) / range5)
float lowerWick5 = math.max(0.0, (math.min(open, close) - low) / range5)
bool chikouBull5 = close > talib.highest(high[DISPLACEMENT - 1], 7)
bool chikouBear5 = close < talib.lowest(low[DISPLACEMENT - 1], 7)

float top15 = math.max(snap15.currentA, snap15.currentB)
float bottom15 = math.min(snap15.currentA, snap15.currentB)
float top30 = math.max(snap30.currentA, snap30.currentB)
float bottom30 = math.min(snap30.currentA, snap30.currentB)
float top1h = math.max(snap1h.currentA, snap1h.currentB)
float bottom1h = math.min(snap1h.currentA, snap1h.currentB)
bool dataReady = closed5m and snap15.ready and snap30.ready and snap1h.ready and not na(currentA5) and not na(currentB5)

// BASE conditions, rescaled by the user's requested timeframe ladder:
// 1H macro -> 30m strategy -> 15m confirmation -> 5m trigger.
bool bullishBias = snap1h.c > top1h and snap30.c > top30 and snap15.c > top15 and close > top5
bool bearishBias = snap1h.c < bottom1h and snap30.c < bottom30 and snap15.c < bottom15 and close < bottom5
bool isLong = bullishBias and not bearishBias ? true : bearishBias and not bullishBias ? false : snap30.tenkan >= snap30.kijun
bool c1 = isLong ? bullishBias : bearishBias
bool c2 = isLong ? (snap1h.tenkan >= snap1h.kijun and snap30.tenkan >= snap30.kijun and snap15.tenkan >= snap15.kijun and tenkan5 >= kijun5) : (snap1h.tenkan <= snap1h.kijun and snap30.tenkan <= snap30.kijun and snap15.tenkan <= snap15.kijun and tenkan5 <= kijun5)
bool c3 = isLong ? (snap1h.tenkan >= snap1h.prevTenkan - snap1h.atr * 0.05 and snap30.tenkan >= snap30.prevTenkan - snap30.atr * 0.05 and snap15.tenkan >= snap15.prevTenkan - snap15.atr * 0.05 and tenkan5 >= tenkan5[1] - atr5 * 0.05) : (snap1h.tenkan <= snap1h.prevTenkan + snap1h.atr * 0.05 and snap30.tenkan <= snap30.prevTenkan + snap30.atr * 0.05 and snap15.tenkan <= snap15.prevTenkan + snap15.atr * 0.05 and tenkan5 <= tenkan5[1] + atr5 * 0.05)
bool c4 = isLong ? (snap1h.futureA > snap1h.futureB and snap1h.futureA >= snap1h.prevFutureA and snap30.futureA > snap30.futureB and snap30.futureA >= snap30.prevFutureA and snap15.futureA > snap15.futureB) : (snap1h.futureA < snap1h.futureB and snap1h.futureA <= snap1h.prevFutureA and snap30.futureA < snap30.futureB and snap30.futureA <= snap30.prevFutureA and snap15.futureA < snap15.futureB)
bool c5 = math.abs(snap1h.futureA - snap1h.futureB) / math.max(snap1h.atr, 0.00000001) >= 0.05 and math.abs(snap30.futureA - snap30.futureB) / math.max(snap30.atr, 0.00000001) >= 0.04 and math.abs(snap15.futureA - snap15.futureB) / math.max(snap15.atr, 0.00000001) >= 0.04
bool c6 = isLong ? (snap1h.chikouBull and snap30.chikouBull and snap15.chikouBull and chikouBull5) : (snap1h.chikouBear and snap30.chikouBear and snap15.chikouBear and chikouBear5)
bool c7 = isLong ? close >= chikouPeak5 - atr5 * 0.15 : close <= chikouTrough5 + atr5 * 0.15
bool c8 = math.abs(close - kijun5) / atr5 <= maxKijunExtensionAtr and math.abs(snap15.c - snap15.kijun) / math.max(snap15.atr, 0.00000001) <= maxKijunExtensionAtr and not (snap15.kijunFlat and snap15.ssbFlat)
bool c9 = isLong ? close >= top5 + (snap15.ssbFlat ? atr5 * 0.15 : 0.0) : close <= bottom5 - (snap15.ssbFlat ? atr5 * 0.15 : 0.0)
bool c10 = not (snap1h.kijunFlat and snap1h.ssbFlat and snap30.kijunFlat and snap30.ssbFlat and snap15.kijunFlat and snap15.ssbFlat)
bool directionalCandle = isLong ? (close > open and clv5 >= 0.45 and body5 >= 0.22) : (close < open and clv5 <= 0.55 and body5 >= 0.22)
bool c11 = directionalCandle and volumeRatio5 >= 0.60
bool c13 = (snap1h.er >= 0.20 or snap30.er >= 0.22 or snap15.er >= 0.22) and not (snap1h.kijunFlat and snap30.kijunFlat and snap15.kijunFlat)
bool c14 = isLong ? (upperWick5 <= 0.45 and (body5 >= 0.22 or lowerWick5 >= 0.25)) : (lowerWick5 <= 0.45 and (body5 >= 0.22 or upperWick5 >= 0.25))
bool c15 = c13 and c8 and (isLong ? tenkan5 >= kijun5 : tenkan5 <= kijun5)

bool triggerKatana = isLong ? (talib.crossover(tenkan5, kijun5) and close > top5 and close > open) : (talib.crossunder(tenkan5, kijun5) and close < bottom5 and close < open)
bool triggerPullback = isLong ? (low <= math.max(tenkan5, kijun5) + atr5 * 0.25 and close > tenkan5 and close > top5 and close > open) : (high >= math.min(tenkan5, kijun5) - atr5 * 0.25 and close < tenkan5 and close < bottom5 and close < open)
bool triggerBreakout = isLong ? (close > priorHigh5 and close > top5 + atr5 * 0.10 and close >= chikouPeak5 and close > open) : (close < priorLow5 and close < bottom5 - atr5 * 0.10 and close <= chikouTrough5 and close < open)
bool triggerFired = triggerKatana or triggerPullback or triggerBreakout

float entryAnchor = close
float stopFloor = math.max(close * 0.0025, atr5 * 0.80)
float stopCeiling = math.max(stopFloor, atr5 * 2.10)
float rawStop = isLong ? math.min(kijun5, math.min(snap15.kijun, snap30.kijun)) - atr5 * slBufferAtr : math.max(kijun5, math.max(snap15.kijun, snap30.kijun)) + atr5 * slBufferAtr
float rawStopDistance = math.abs(entryAnchor - rawStop)
float stopDistance = math.min(math.max(rawStopDistance, stopFloor), stopCeiling)
float targetDistance = stopDistance * 2.25
float stopPrice = isLong ? entryAnchor - stopDistance : entryAnchor + stopDistance
float targetPrice = isLong ? entryAnchor + targetDistance : entryAnchor - targetDistance
float rr = targetDistance / math.max(stopDistance, 0.00000001)
bool c12 = rr >= 1.5 and rr <= 3.0 and targetDistance >= entryAnchor * roundTripCostPct * 2.0
bool c16 = math.abs(close - tenkan5) / atr5 <= 0.85
float costToRisk = entryAnchor * roundTripCostPct / math.max(stopDistance, 0.00000001)
bool c17 = costToRisk <= 0.45

float regimeScore = (c1 ? 1.0 : 0.0) + (c3 ? 1.0 : 0.0) + (c4 ? 1.0 : 0.0) + (c6 ? 1.0 : 0.0) + (c17 ? 1.2 : 0.0)
float qualityScore = (c5 ? 0.6 : 0.0) + (c8 ? 1.0 : 0.0) + (c9 ? 1.0 : 0.0) + (c13 ? 1.0 : 0.0) + (c14 ? 0.6 : 0.0) + (c15 ? 1.0 : 0.0)
float triggerScore = (c2 ? 0.6 : 0.0) + (c7 ? 0.6 : 0.0) + (c10 ? 0.8 : 0.0) + (c11 ? 1.2 : 0.0) + (c12 ? 1.0 : 0.0) + (c16 ? 1.2 : 0.0) + (c17 ? 1.2 : 0.0)
float bookPct = (regimeScore + qualityScore + triggerScore) / 17.0 * 100.0
float qualityPct = qualityScore / 5.2 * 100.0
float triggerPct = triggerScore / 6.6 * 100.0
bool hardVetoPassed = c1 and c3 and c4 and c6 and c17
bool bookFires = hardVetoPassed and qualityPct >= 60.0 and triggerPct >= 60.0 and bookPct >= 70.0
int passedCount = (c1 ? 1 : 0) + (c2 ? 1 : 0) + (c3 ? 1 : 0) + (c4 ? 1 : 0) + (c5 ? 1 : 0) + (c6 ? 1 : 0) + (c7 ? 1 : 0) + (c8 ? 1 : 0) + (c9 ? 1 : 0) + (c10 ? 1 : 0) + (c11 ? 1 : 0) + (c12 ? 1 : 0) + (c13 ? 1 : 0) + (c14 ? 1 : 0) + (c15 ? 1 : 0) + (c16 ? 1 : 0) + (c17 ? 1 : 0)

bool strictSignal = dataReady and triggerFired and bookFires
bool rawTrigger = dataReady and triggerFired and not strictSignal
bool debugSignal = debugVirtualTriggerTrades and rawTrigger
bool entryDecision = strictSignal or debugSignal
bool enterLong = entryDecision and isLong and allowLong and strategy.position_size == 0
bool enterShort = entryDecision and not isLong and allowShort and strategy.position_size == 0
if enterLong {
    strategy.entry("Lite 5m Long", strategy.long, qty=qty, comment=debugSignal ? "DEBUG raw trigger long" : "BASE Lite 5m long")
    strategy.exit("Lite 5m Long exit", from_entry="Lite 5m Long", stop=stopPrice, limit=targetPrice)
}
if enterShort {
    strategy.entry("Lite 5m Short", strategy.short, qty=qty, comment=debugSignal ? "DEBUG raw trigger short" : "BASE Lite 5m short")
    strategy.exit("Lite 5m Short exit", from_entry="Lite 5m Short", stop=stopPrice, limit=targetPrice)
}
if strategy.position_size > 0 and strategy.opentrades > 0 and bar_index - strategy.opentrades_entry_bar_index(0) >= maxHoldBars {
    strategy.close("Lite 5m Long", comment="time stop")
}
if strategy.position_size < 0 and strategy.opentrades > 0 and bar_index - strategy.opentrades_entry_bar_index(0) >= maxHoldBars {
    strategy.close("Lite 5m Short", comment="time stop")
}

// Only three uncluttered, correctly stepped guide lines are drawn by default.
plot(kijun5, title="5m Kijun", color=color.orange, linewidth=2)
plot(snap15.kijun, title="Built 15m Kijun", color=color.teal, linewidth=2, style=plotStyle.stepLine)
plot(snap1h.kijun, title="Built 1H Kijun", color=color.purple, linewidth=2, style=plotStyle.stepLine)
plotshape(strictSignal and isLong, title="Strict Lite long", location=location.belowbar, shape=shape.triangleup, color=color.lime, size=size.normal, text="LITE L")
plotshape(strictSignal and not isLong, title="Strict Lite short", location=location.abovebar, shape=shape.triangledown, color=color.red, size=size.normal, text="LITE S")
plotshape(showDiagnosticMarkers and rawTrigger and isLong, title="Raw long trigger", location=location.belowbar, shape=shape.diamond, color=color.aqua, size=size.tiny, text="RAW")
plotshape(showDiagnosticMarkers and rawTrigger and not isLong, title="Raw short trigger", location=location.abovebar, shape=shape.diamond, color=color.aqua, size=size.tiny, text="RAW")
plotshape(showDiagnosticMarkers and dataReady and triggerFired and not hardVetoPassed, title="Hard veto", location=location.abovebar, shape=shape.xcross, color=color.orange, size=size.tiny, text="V")

static table dashboard = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 0.25), border_width=1)
if barstate.islast {
    table.cell(dashboard, 0, 0, "BASE LITE 5/15/30/1H")
    table.cell(dashboard, 1, 0, chartIs5m ? "5m OK" : "CHANGE TO 5m", textcolor=chartIs5m ? color.lime : color.red)
    table.cell(dashboard, 0, 1, "Closed 15m / 30m")
    table.cell(dashboard, 1, 1, str.tostring(array.length(c15)) + " / " + str.tostring(array.length(c30)))
    table.cell(dashboard, 0, 2, "Closed 1H")
    table.cell(dashboard, 1, 2, str.tostring(array.length(c1h)))
    table.cell(dashboard, 0, 3, "Data")
    table.cell(dashboard, 1, 3, dataReady ? "READY" : "WARM-UP: need 57 H1", textcolor=dataReady ? color.lime : color.orange)
    table.cell(dashboard, 0, 4, "Bias")
    table.cell(dashboard, 1, 4, dataReady ? (isLong ? "LONG" : "SHORT") : "-")
    table.cell(dashboard, 0, 5, "Trigger")
    table.cell(dashboard, 1, 5, triggerKatana ? "KATANA" : triggerPullback ? "PULLBACK" : triggerBreakout ? "BREAKOUT" : "-", textcolor=triggerFired ? color.aqua : color.gray)
    table.cell(dashboard, 0, 6, "Conditions")
    table.cell(dashboard, 1, 6, str.tostring(passedCount) + " / 17")
    table.cell(dashboard, 0, 7, "Book gate")
    table.cell(dashboard, 1, 7, str.tostring(bookPct, "#.0") + "%", textcolor=bookFires ? color.lime : color.orange)
    table.cell(dashboard, 0, 8, "Status")
    table.cell(dashboard, 1, 8, strictSignal ? "STRICT SIGNAL" : debugSignal ? "DEBUG ENTRY" : rawTrigger ? "RAW BLOCKED" : hardVetoPassed ? "WAITING" : "HARD VETO", textcolor=strictSignal ? color.lime : debugSignal ? color.aqua : rawTrigger ? color.orange : hardVetoPassed ? color.yellow : color.red)
}
