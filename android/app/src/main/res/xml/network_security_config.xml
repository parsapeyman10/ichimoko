<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext stays OFF for the whole app. The only exception is the loopback/emulator host,
  so a developer can point the optional server-engine tab at a backend running on their own
  machine without minting a certificate.

  This mirrors com.aurum.edge.data.EngineApi.CLEARTEXT_HOSTS exactly: a LAN or public host
  over plain HTTP is refused in code as well, because trading traffic on an open network is
  a real hazard. For a non-local backend use HTTPS (a tunnel such as cloudflared or ngrok
  provides one).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
